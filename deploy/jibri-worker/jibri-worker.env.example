# Jibri stop worker environment: a TEMPLATE (names only, no values).
#
# Copy to a file OUTSIDE the repository, e.g. /etc/slclassroom/jibri-worker.env,
# owned by the PM2 user, mode 600. Never commit the real file.
# Fill the values from the same source as the Next.js app's environment: the
# Jitsi settings MUST be identical to the app's (the app compares them field
# by field, the JWT secret through a non-reversible fingerprint, and refuses
# mode "on" otherwise).

# Allows the worker process to start at all (what it does is decided by the
# shared mode in the database, switched by an administrator).
JIBRI_SERVER_STOP=on

# The SAME database as the app (explicit: the worker never reads .env).
DATABASE_URL=

# Jitsi (the same values as the app).
JITSI_DOMAIN=
JITSI_ENABLE_JWT_AUTH=true
JITSI_JWT_SECRET=
# Set explicitly (also when the app relies on the defaults "saastution" / "jitsi"),
# so nothing else can supply them.
JITSI_JWT_ISS=
JITSI_JWT_AUD=
# Optional; only if the app sets it.
# JITSI_JWT_SUB=

# Optional overrides (defaults derived from JITSI_DOMAIN); set them here AND
# in the app if either uses a non-default value.
# JITSI_XMPP_WEBSOCKET_URL=wss://<JITSI_DOMAIN>/xmpp-websocket
# JITSI_MUC_DOMAIN=conference.<JITSI_DOMAIN>
# JITSI_RECORDER_DOMAIN=recorder.<JITSI_DOMAIN>
# JITSI_FOCUS_JID=focus@auth.<JITSI_DOMAIN>

# YouTube: to read the PINNED stream's status with the teacher's stored
# authorization (the same values as the app's).
GOOGLE_YOUTUBE_CLIENT_ID=
GOOGLE_YOUTUBE_CLIENT_SECRET=
YOUTUBE_TOKEN_ENCRYPTION_KEY=
