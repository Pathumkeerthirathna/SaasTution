# SLClassroom app server: student email outbox + background worker.
# Tracked template (the root .env.example is git-ignored by the ".env*" rule).
# Copy the lines you need into the app server's real environment file.
# Full guide: docs/student-email-delivery.md
#
# REQUIRED. 64 hex characters (32 bytes): `openssl rand -hex 32`.
# Encrypts queued temporary passwords (AES-256-GCM). Keep it OUT of the
# database, database backups and git; back it up in the password manager /
# secrets store. See "Encryption key operations" in the guide before changing it.
EMAIL_PAYLOAD_ENCRYPTION_KEY=

# An email provider is also required (unchanged, see the root configuration):
# SENDER_API_TOKEN / SENDER_FROM_EMAIL / SENDER_FROM_NAME, or SMTP_HOST / SMTP_PORT /
# SMTP_USER / SMTP_PASS / SMTP_SECURE / SMTP_FROM. Without one, credential emails stay
# queued with EMAIL_NOT_CONFIGURED (never marked sent, no password replaced).

# Optional tuning (defaults shown).
EMAIL_DELIVERY_MAX_ATTEMPTS=5
EMAIL_DELIVERY_RETRY_BASE_SECONDS=60
EMAIL_DELIVERY_RETRY_MAX_SECONDS=21600
EMAIL_DELIVERY_LEASE_SECONDS=300
EMAIL_DELIVERY_SEND_TIMEOUT_SECONDS=60
EMAIL_DELIVERY_PAYLOAD_RETENTION_HOURS=168
EMAIL_WORKER_ENABLED=true
EMAIL_WORKER_POLL_INTERVAL_SECONDS=15
EMAIL_WORKER_BATCH_SIZE=10
EMAIL_WORKER_CONCURRENCY=2
EMAIL_WORKER_SHUTDOWN_TIMEOUT_MS=8000
# Whole graceful-shutdown budget (all background tasks). PM2 kill_timeout must be LARGER
# (e.g. 12000): PM2 force-kills the process when kill_timeout expires.
PROCESS_SHUTDOWN_TIMEOUT_MS=9000
