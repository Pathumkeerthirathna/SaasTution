// ---- Unified lecture attendance (docs/lecture-attendance.md) -----------------
//
// One register per lecture and one canonical attendance record per student per
// lecture, fed by online visits (Attendance), QR scans and teacher decisions.
// The existing Attendance table and every existing attendance calculation are
// unchanged. CHECK constraints, the register freeze trigger and the
// append-only triggers are hand-written in migration
// 20261110140000_add_lecture_attendance. Timestamps have no database default
// and no @updatedAt: the application writes real UTC instants.

enum LectureAttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

/// Where a record's current status came from.
enum AttendanceStatusSource {
  /// Online / QR evidence (PRESENT or LATE).
  AUTO
  /// A teacher decision (teacherStatus).
  TEACHER
  /// ABSENT written by finalization.
  FINALIZATION
  /// Historical online backfill (PRESENT only).
  BACKFILL
}

enum AttendanceScanResult {
  VALID
  INVALID_QR
  QR_UNVERIFIABLE
  WRONG_TEACHER
  NOT_ELIGIBLE
  ELIGIBILITY_UNKNOWN
  LECTURE_UNAVAILABLE
}

enum AttendanceScanEffect {
  STATUS_UPDATED
  EVIDENCE_ONLY
  REVIEW_REQUIRED
  DUPLICATE
  RECORDED_ONLY
  NONE
}

enum AttendanceAuditAction {
  CREATED_AUTO
  AUTO_UPDATED
  AUTO_RECALCULATED
  EVIDENCE_RECORDED
  TEACHER_SET
  EVIDENCE_ACCEPTED
  EVIDENCE_DISMISSED
  FINALIZE_ABSENT
  BACKFILL
}

enum RegisterAuditAction {
  CREATED
  GRACE_CHANGED
  SCHEDULE_SYNCED
  FINALIZED
}

/// One per lecture. Copies the lecture schedule and the class grace period
/// when created; frozen once finalized (trigger: no UPDATE after finalization,
/// never DELETE).
model LectureAttendanceRegister {
  lectureId            String    @id
  classId              String
  scheduledStartAt     DateTime
  scheduledEndAt       DateTime?
  graceMinutes         Int
  finalizedAt          DateTime?
  finalizedByTeacherId String?
  version              Int
  createdAt            DateTime
  updatedAt            DateTime

  lecture     Lecture  @relation(fields: [lectureId, classId], references: [id, classId], onDelete: Restrict)
  class       Class    @relation(fields: [classId], references: [id], onDelete: Restrict)
  finalizedBy Teacher? @relation(fields: [finalizedByTeacherId], references: [id], onDelete: Restrict)
  records     LectureAttendance[]
  auditLogs   LectureAttendanceRegisterAuditLog[]
  /// At most one (its key is lectureId): QR attendance closed by the teacher.
  qrClosures  LectureQrAttendanceClosure[]

  @@unique([lectureId, classId])
  @@index([classId, finalizedAt])
}

/// The canonical attendance of one student for one lecture.
model LectureAttendance {
  id                 String                   @id @default(uuid())
  lectureId          String
  classId            String
  studentId          String
  status             LectureAttendanceStatus
  statusSource       AttendanceStatusSource
  firstOnlineAt      DateTime?
  firstQrAt          DateTime?
  autoStatus         LectureAttendanceStatus?
  teacherStatus      LectureAttendanceStatus?
  teacherDecidedAt   DateTime?
  teacherDecidedById String?
  pendingReviewSince DateTime?
  version            Int
  createdAt          DateTime
  updatedAt          DateTime

  register   LectureAttendanceRegister @relation(fields: [lectureId, classId], references: [lectureId, classId], onDelete: Restrict)
  class      Class                     @relation(fields: [classId], references: [id], onDelete: Restrict)
  student    Student                   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  decidedBy  Teacher?                  @relation(fields: [teacherDecidedById], references: [id], onDelete: Restrict)
  auditLogs  AttendanceAuditLog[]
  scanEvents AttendanceScanEvent[]

  @@unique([lectureId, studentId])
  @@index([classId, studentId])
  @@index([studentId, lectureId])
  @@index([lectureId, status])
  @@index([lectureId, pendingReviewSince])
}

/// Every QR scan submission, valid or not (append-only).
model AttendanceScanEvent {
  id                  String               @id @default(uuid())
  lectureId           String
  classId             String
  classSessionId      String?
  scannedByTeacherId  String
  clientScanId        String
  scannedTokenHash    String?
  qrTokenId           String?
  studentId           String?
  result              AttendanceScanResult
  effect              AttendanceScanEffect
  /// The approvalAt reason behind the eligibility decision; null when no
  /// student was identified. CHECK-limited to the approvalAt reasons.
  eligibilityReason   String?
  afterFinalization   Boolean
  lectureAttendanceId String?
  clientScannedAt     DateTime?
  receivedAt          DateTime

  lecture      Lecture            @relation(fields: [lectureId, classId], references: [id, classId], onDelete: Restrict)
  classSession ClassSession?      @relation(fields: [classSessionId], references: [id], onDelete: Restrict)
  scannedBy    Teacher            @relation(fields: [scannedByTeacherId], references: [id], onDelete: Restrict)
  qrToken      StudentQrToken?    @relation(fields: [qrTokenId], references: [id], onDelete: Restrict)
  student      Student?           @relation(fields: [studentId], references: [id], onDelete: Restrict)
  attendance   LectureAttendance? @relation(fields: [lectureAttendanceId], references: [id], onDelete: Restrict)
  auditLogs    AttendanceAuditLog[]

  @@unique([scannedByTeacherId, clientScanId])
  @@index([lectureId, receivedAt])
  @@index([studentId, lectureId, receivedAt])
}

/// Every change to a LectureAttendance record, one row per record version
/// (append-only).
model AttendanceAuditLog {
  id                  String                   @id @default(uuid())
  lectureAttendanceId String
  version             Int
  lectureId           String
  studentId           String
  action              AttendanceAuditAction
  fromStatus          LectureAttendanceStatus?
  toStatus            LectureAttendanceStatus
  fromTeacherStatus   LectureAttendanceStatus?
  toTeacherStatus     LectureAttendanceStatus?
  fromAutoStatus      LectureAttendanceStatus?
  toAutoStatus        LectureAttendanceStatus?
  /// TEACHER | SYSTEM (CHECK).
  actorRole           String
  actorId             String?
  reason              String?
  afterFinalization   Boolean
  scanEventId         String?
  attendanceVisitId   String?
  registerAuditId     String?
  createdAt           DateTime

  record        LectureAttendance                  @relation(fields: [lectureAttendanceId], references: [id], onDelete: Restrict)
  scanEvent     AttendanceScanEvent?               @relation(fields: [scanEventId], references: [id], onDelete: Restrict)
  visit         Attendance?                        @relation(fields: [attendanceVisitId], references: [id], onDelete: Restrict)
  registerAudit LectureAttendanceRegisterAuditLog? @relation(fields: [registerAuditId], references: [id], onDelete: Restrict)

  @@unique([lectureAttendanceId, version])
  @@index([lectureId, createdAt])
  @@index([studentId, createdAt])
}

/// Every change to a register, one row per register version (append-only).
model LectureAttendanceRegisterAuditLog {
  id                      String              @id @default(uuid())
  lectureId               String
  version                 Int
  action                  RegisterAuditAction
  fromGraceMinutes        Int?
  toGraceMinutes          Int?
  fromScheduledStartAt    DateTime?
  toScheduledStartAt      DateTime?
  fromScheduledEndAt      DateTime?
  toScheduledEndAt        DateTime?
  finalizedAt             DateTime?
  eligibleCount           Int?
  unknownEligibilityCount Int?
  absentCreatedCount      Int?
  recalculatedCount       Int?
  /// TEACHER | SYSTEM (CHECK).
  actorRole               String
  actorId                 String?
  reason                  String?
  createdAt               DateTime

  register       LectureAttendanceRegister @relation(fields: [lectureId], references: [lectureId], onDelete: Restrict)
  recalculations AttendanceAuditLog[]

  @@unique([lectureId, version])
  @@index([lectureId, createdAt])
}

/// QR attendance closed by the lecture's teacher (Stage 5.4b correction).
/// QR scanning opens 30 minutes before the scheduled start and stays open
/// until this row exists; the scheduled end never closes it. One row per
/// lecture, written once and never changed or removed (append-only trigger,
/// hand-written in the migration): no reopening. The row is both the closure
/// state and its audit record (who closed it and when). A separate table, not
/// register columns: a finalized register is frozen, but scanning (as
/// recorded-only / review evidence) continues after finalization until closed.
model LectureQrAttendanceClosure {
  lectureId         String   @id
  classId           String
  closedAt          DateTime
  closedByTeacherId String

  register LectureAttendanceRegister @relation(fields: [lectureId, classId], references: [lectureId, classId], onDelete: Restrict)
  closedBy Teacher                   @relation(fields: [closedByTeacherId], references: [id], onDelete: Restrict)
}

model Message {
  id         String            @id @default(uuid())
  content    String
  classId    String
  createdAt  DateTime          @default(now())
  class      Class             @relation(fields: [classId], references: [id])
  deliveries MessageDelivery[]

  @@index([classId, createdAt])
}

model MessageDelivery {
  id                String                @id @default(uuid())
  messageId         String
  studentId         String
  status            MessageDeliveryStatus @default(QUEUED)
  provider          String?
  providerMessageId String?
  error             String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  message           Message               @relation(fields: [messageId], references: [id])
  student           Student               @relation(fields: [studentId], references: [id])

  @@unique([messageId, studentId])
  @@index([messageId, createdAt])
  @@index([messageId, status])
  @@index([providerMessageId])
}

model ClassPayment {
  id String @id @default(uuid())

  classId           String
  studentId         String
  classStudentFeeId String

  amount Int

  note String?

  slipFileName  String?
  slipFileUrl   String?
  slipMimeType  String?
  slipSizeBytes Int?

  status          ClassPaymentStatus @default(PENDING)
  teacherFeedback String?

  submittedAt          DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  confirmedAt          DateTime?
  confirmedByTeacherId String?

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  classStudentFee ClassStudentFee @relation(fields: [classStudentFeeId], references: [id])

  confirmedByTeacher Teacher? @relation("ClassPaymentConfirmedBy", fields: [confirmedByTeacherId], references: [id])

  messages PaymentMessage[]

  /// Partial payments (Stage 1, migration 20261122120000): where the payment
  /// came from. Existing rows and student uploads: STUDENT_SLIP. A
  /// TEACHER_RECORDED payment (cash / bank transfer received by the teacher)
  /// is CONFIRMED when recorded and carries paymentMethod, receivedAt and
  /// recordedByTeacherId (hand-written CHECKs keep these consistent).
  source              ClassPaymentSource  @default(STUDENT_SLIP)
  paymentMethod       ClassPaymentMethod?
  /// When the teacher received the money (real UTC instant).
  receivedAt          DateTime?
  /// The teacher who recorded it (never changed afterwards; audit).
  recordedByTeacherId String?
  recordedByTeacher   Teacher?            @relation("ClassPaymentRecordedBy", fields: [recordedByTeacherId], references: [id], onDelete: SetNull)
  /// Idempotency key of the recording request: a repeated request finds the
  /// existing payment instead of creating a second one.
  requestKey          String?             @unique
  /// Set when the payment was reversed. The payment itself is never changed
  /// or deleted; a reversed payment no longer counts as received.
  reversal            ClassPaymentReversal?

  @@index([studentId])
  @@index([classId, status])
  @@index([classStudentFeeId])
  @@index([confirmedByTeacherId])
  @@index([recordedByTeacherId])
}

enum ClassPaymentSource {
  STUDENT_SLIP
  TEACHER_RECORDED
}

enum ClassPaymentMethod {
  CASH
  BANK_TRANSFER
  OTHER
}

enum ClassPaymentActorRole {
  TEACHER
  ADMIN
}

/// Append-only audit record of a reversed payment (partial payments, Stage 1).
/// One per payment, always the full payment amount (CHECKs in migration
/// 20261122120000). The original ClassPayment row is kept unchanged; the
/// shared fee calculation simply stops counting it as received. Actor ids are
/// stored as text without a foreign key (like JibriShutdownOverride), so the
/// record survives the actor's account.
model ClassPaymentReversal {
  id             String                @id @default(uuid())
  paymentId      String                @unique
  amount         Int
  reason         String
  reversedByRole ClassPaymentActorRole
  reversedById   String
  /// Real UTC instant of the reversal.
  createdAt      DateTime              @default(now())
  payment        ClassPayment          @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model PaymentMessage {
  id             String               @id @default(uuid())
  paymentId      String
  senderRole     PaymentMessageSender
  studentId      String?
  teacherId      String?
  message        String
  proofFileName  String?
  proofFileUrl   String?
  proofMimeType  String?
  proofSizeBytes Int?
  createdAt      DateTime             @default(now())
  payment        ClassPayment         @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  student        Student?             @relation(fields: [studentId], references: [id])
  teacher        Teacher?             @relation(fields: [teacherId], references: [id])

  @@index([paymentId, createdAt])
}

model Grade {
  id        Int    @id @default(autoincrement())
  GradeDesc String
  Status    Int    @default(0)

  students Student[]
}

enum Role {
  TEACHER
  STUDENT
  GUARDIAN
  ADMIN
}

enum MessageDeliveryStatus {
  QUEUED
  SENT
  FAILED
}

enum NoteKind {
  NOTE
  SUPPORTING_MATERIAL
}

enum Weekday {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum QuizAnswerType {
  SINGLE
  MULTIPLE
}

enum BundleStatus {
  DRAFT
  SENT
}

enum MaterialBundleItemType {
  TUTE
  PAPER
}

enum ClassPaymentStatus {
  PENDING
  CONFIRMED
  NEEDS_CLARIFICATION
}

enum PaymentMessageSender {
  STUDENT
  TEACHER
}

enum StudentClassAction {
  ASSIGNED
  UNASSIGNED
}

// ---------------------------------------------------------------------------
// Breakout Room Activities (live-class assignments and quizzes for breakout
// rooms). Separate from the lecture Assignment / Quiz models above. All rows
// belong to one ClassSession and are removed when it ends (after the teacher
// is offered an export). Files live in storage/breakout-activities/<sessionId>/.
// ---------------------------------------------------------------------------

enum BreakoutTargetRoomType {
  MAIN
  BREAKOUT
}

enum BreakoutActivityState {
  DRAFT
  PUBLISHED
  CLOSED
}

enum BreakoutQuizAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
}

/// Group Activities: INDIVIDUAL (each student's own work: the existing
/// drafts / submissions / attempts) or GROUP (one shared work, attempt and
/// final submission per breakout-room group: BreakoutGroupAssignmentWork /
/// BreakoutGroupQuizAttempt). Every existing row is INDIVIDUAL.
enum BreakoutWorkMode {
  INDIVIDUAL
  GROUP
}

model BreakoutAssignment {
  id             String                 @id @default(uuid())
  classSessionId String
  teacherId      String
  publishGroupId String?
  targetRoomType BreakoutTargetRoomType
  targetRoomId   String?
  targetRoomName String                 @db.VarChar(120)
  title          String                 @db.VarChar(200)
  instructions   String
  briefFileName  String?                @db.VarChar(200)
  briefFilePath  String?
  briefFileSize  Int?
  state          BreakoutActivityState  @default(DRAFT)
  publishedAt    DateTime?
  closedAt       DateTime?
  status         Int                    @default(0)
  workMode       BreakoutWorkMode       @default(INDIVIDUAL)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  classSession ClassSession                   @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  teacher      Teacher                        @relation(fields: [teacherId], references: [id])
  drafts       BreakoutAssignmentDraft[]
  submissions  BreakoutAssignmentSubmission[]
  groupWork    BreakoutGroupAssignmentWork?

