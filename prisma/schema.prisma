  targetRoomName   String                 @db.VarChar(120)
  title            String                 @db.VarChar(200)
  instructions     String?
  /// BreakoutQuizDefinition (lib/breakout-activities/validation.ts). Holds
  /// the answer keys: never sent to students as-is (quiz-projection.mjs).
  questions        Json
