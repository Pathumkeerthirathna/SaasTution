generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Teacher {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  contact   String?
  createdAt DateTime @default(now())

  // Admin confirmation of a newly registered teacher account.
  isConfirmed Boolean   @default(false)
  confirmedAt DateTime?
  isRejected  Boolean   @default(false)
  rejectedAt  DateTime?

  // Admin-imposed block, with the reason shown to the teacher at login.
  isBlocked   Boolean   @default(false)
  blockedAt   DateTime?
  blockReason String?

  // Email ownership confirmation via a one-time code. A teacher cannot log
  // in until this is true.
  emailConfirmed   Boolean   @default(false)
  emailConfirmedAt DateTime?

  profile TeacherProfile?

  youtubeConnection YouTubeConnection?

  classes                Class[]
  students               Student[]
  studentEmailDeliveries EmailDelivery[]
  confirmedClassPayments ClassPayment[]        @relation("ClassPaymentConfirmedBy")
  recordedClassPayments  ClassPayment[]        @relation("ClassPaymentRecordedBy")
  issuedFreeCards        ClassStudentFee[]     @relation("ClassStudentFeeFreeCardIssuedBy")
  paperSupportMessages   PaperSupportMessage[]
  paymentMessages        PaymentMessage[]
  paperConfig            TeacherPaperConfig?

  /// Students whose LATEST confirmation decision (approve or decline) this
  /// teacher made (Student.confirmedById).
  approvedStudents Student[] @relation("ConfirmedStudents")

  studentConfirmationDecisions StudentConfirmationHistory[]

  finalizedAttendanceRegisters LectureAttendanceRegister[]
  attendanceDecisions          LectureAttendance[]
  attendanceScans              AttendanceScanEvent[]
  qrAttendanceClosures         LectureQrAttendanceClosure[]

  approvedDevices StudentDevice[] @relation("ApprovedDevices")

  announcements TeacherAnnouncement[]

  profileSections TeacherProfileSection[]

  eventTypes     TeacherEventType[]
  calendarEvents TeacherCalendarEvent[]

  subscriptions TeacherSubscription[]

  breakoutAssignments BreakoutAssignment[]
  breakoutQuizzes     BreakoutQuiz[]

  /// Recorded lecture parts this teacher uploaded (RecordedLecture.teacherId).
  recordedLectures        RecordedLecture[] @relation("RecordedLectureTeacher")
  /// Recorded lecture parts for which this teacher requested deletion
  /// (RecordedLecture.deletedByTeacherId).
  deletedRecordedLectures RecordedLecture[] @relation("RecordedLectureDeletedBy")

  /// Storage quota (Stage 3.1): the admin's individual override (none = the
  /// subscription plan's storageGB), its audit history, and in-flight Notes /
  /// submission upload reservations.
  storageLimit        TeacherStorageLimit?
  storageLimitChanges TeacherStorageLimitChange[]
  storageReservations StorageReservation[]

  /// Bank accounts the teacher publishes for fee payments (Payment Details on
  /// the teacher profile). Not related to ClassPayment / receipts / gateways.
  paymentAccounts TeacherPaymentAccount[]

  @@index([createdAt])
}

enum SubscriptionPlanStatus {
  ACTIVE
  INACTIVE
}

enum SubscriptionInterval {
  MONTHLY
  YEARLY
}

model SubscriptionPlan {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  price    Decimal              @db.Decimal(10, 2)
  currency String               @default("LKR")
  interval SubscriptionInterval @default(MONTHLY)

  maxLiveParticipants Int

  unlimitedLiveSessions Boolean @default(true)
  unlimitedRecording    Boolean @default(true)
  unlimitedStudents     Boolean @default(true)

  maxTeachers Int?
  storageGB   Int?

  status    SubscriptionPlanStatus @default(ACTIVE)
  sortOrder Int                    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions TeacherSubscription[]

  @@index([status])
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  SUSPENDED
}

model TeacherSubscription {
  id String @id @default(uuid())

  teacherId String
  planId    String

  status SubscriptionStatus @default(ACTIVE)

  startDate DateTime
  endDate   DateTime?

  price    Decimal @db.Decimal(10, 2)
  currency String  @default("LKR")

  autoRenew Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher Teacher          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  plan    SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([teacherId])
  @@index([planId])
  @@index([status])
}

model TeacherEventType {
  id        Int    @id @default(autoincrement())
  teacherId String

  name        String
  description String?
  color       String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher Teacher                @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  events  TeacherCalendarEvent[]

  @@unique([teacherId, name])
  @@index([teacherId])
}

model TeacherCalendarEvent {
  id Int @id @default(autoincrement())

  teacherId   String
  eventTypeId Int

  title       String
  description String?

  startDateTime DateTime
  endDateTime   DateTime
  isAllDay      Boolean  @default(false)

  location   String?
  meetingUrl String?

  // 0 = active, 1 = removed (soft-deleted). Removed events are hidden everywhere.
  status Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher   Teacher          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  eventType TeacherEventType @relation(fields: [eventTypeId], references: [id])

  @@index([teacherId, status, startDateTime])
  @@index([eventTypeId])
}

enum TeacherProfileSectionType {
  ABOUT_ME
  ANNOUNCEMENTS
  SUBJECTS
  SOCIAL_MEDIA
  QUALIFICATIONS
  ACHIEVEMENTS
}

model TeacherProfileSection {
  id String @id @default(uuid())

  teacherId String

  sectionType TeacherProfileSectionType

  displayOrder Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, sectionType])
  @@unique([teacherId, displayOrder])
  @@index([teacherId])
}

model TeacherAnnouncement {
  id String @id @default(uuid())

  teacherId String

  imageName   String
  description String @db.Text

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([teacherId, sortOrder])
}

model YouTubeConnection {
  id String @id @default(uuid())

  teacherId String  @unique
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  // YouTube channel information
  channelId    String
  channelTitle String?

  // OAuth credential
  // Store the encrypted refresh token here.
  refreshTokenEncrypted String @db.Text

  // Reusable YouTube Live Stream resource
  // One stream per teacher, reused for future classes.
  liveStreamId String?

  status YouTubeConnectionStatus @default(CONNECTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([channelId])
}

enum YouTubeConnectionStatus {
  CONNECTED
  REAUTH_REQUIRED
}

model District {
  id   Int    @id @default(autoincrement())
  name String @unique

  cities City[]

  teacherProfiles TeacherProfile[]
}

model City {
  id         Int @id @default(autoincrement())
  districtId Int

  name String

  district District @relation(fields: [districtId], references: [id])

  teacherProfiles TeacherProfile[]

  @@unique([districtId, name])
}

enum TeacherPaymentAccountType {
  SAVINGS
  CURRENT
  OTHER
}

/// A bank account a teacher publishes on their profile so students and
/// parents know where to pay fees ("Payment Details"). Display information
/// only: it is NOT ClassPayment, a receipt, a payment confirmation or a
/// gateway setting, and nothing in the payment workflows reads it.
///
/// Rules (services/teacher-payment-account-service.ts):
///   - many accounts per teacher; exactly one primary while any exist (a
///     partial unique index allows at most one primary among non-deleted
///     rows; the service keeps at least one, inside a transaction);
///   - removed = status 1 (soft delete, the project convention), never shown
///     or edited again;
///   - shown to visitors and students only when status 0, isActive, isPublic
///     and the profile's isDisplayPaymentDetails switch is on.
/// Migration 20261125120000_add_teacher_payment_accounts (partial index and
/// CHECKs hand-written).
model TeacherPaymentAccount {
  id String @id @default(uuid())

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])

  /// Optional display name, e.g. "Fees account".
  label             String?                    @db.VarChar(60)
  accountHolderName String                     @db.VarChar(120)
  bankName          String                     @db.VarChar(120)
  branchName        String?                    @db.VarChar(120)
  accountNumber     String                     @db.VarChar(34)
  accountType       TeacherPaymentAccountType  @default(SAVINGS)

  isPrimary Boolean @default(false)
  isPublic  Boolean @default(false)
  isActive  Boolean @default(true)

  /// 0 = active, 1 = removed (soft delete).
  status Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId, status])
}

enum TeacherTitle {
  MR
  MRS
  MS
  DR
  PROF
  ENG
}

model TeacherProfile {
  id String @id @default(uuid())

  // Owner teacher account
  teacherId String  @unique
  teacher   Teacher @relation(fields: [teacherId], references: [id])

  // Public profile URL
  // Example:
  // slclassroom.live/pathum-kumara
  // slclassroom.live/sarah-wickramasinghe
  slug String @unique

  // Title shown before the teacher's display name
  // Example: Mr. Pathum Kumara
  title TeacherTitle @default(MR)

  // Name shown on the public profile
  // Defaults to the teacher's account name but can be customized
  displayName String?

  // Profile images
  // profileImageUrl is the DISPLAY URL every consumer reads (header, public
  // profile, search, Jitsi photoUrl): a legacy "/uploads/teachers/..." path for
  // photos uploaded before unified storage, or the versioned
  // "/api/teacher-photos/{teacherId}/{storedName}" URL of a unified-storage photo.
  profileImageUrl String?
  coverImageUrl   String?

  /// Unified storage (profile photos): the photo's RELATIVE key below
  /// FILE_STORAGE_ROOT (Teachers/{teacherId}/Profile/Photo/{32 hex}.{jpg|png|webp}).
  /// Null for no photo or a legacy photo (profileImageUrl only). Counted in the
  /// teacher's storage quota (category PROFILE_IMAGE). The four profileImage*
  /// columns are set and cleared together. While a removal is pending the key
  /// stays and profileImageUrl is NULL (still counted until the file is gone).
  /// CHECKs (hand-written in migration 20261117120100_add_teacher_profile_image_storage):
  /// TeacherProfile_profileImage_all_or_none, TeacherProfile_profileImageStorageKey_format,
  /// TeacherProfile_profileImageStorageKey_owner, TeacherProfile_profileImageSha256_format,
  /// TeacherProfile_profileImageSizeBytes_range, TeacherProfile_profileImageMimeType_allowed.
  profileImageStorageKey String? @unique @db.VarChar(512)
  /// SHA-256 (64 lowercase hex) of the stored photo, computed while it was written.
  profileImageSha256     String? @db.Char(64)
  /// Exact stored size in bytes (1 .. 2,097,152).
  profileImageSizeBytes  Int?
  /// image/jpeg, image/png or image/webp (from the file's signature, never the client).
  profileImageMimeType   String? @db.VarChar(32)

  // Professional title shown under teacher name
  // Examples:
  // Mathematics Teacher
  // Physics Lecturer
  // Combined Maths Instructor
  // ICT Tutor
  designation String?

  // Short marketing headline
  // Examples:
  // Helping students achieve A passes in Mathematics
  // Building strong foundations for O/L Science
  // 8+ years guiding students to exam success
  headline String?

  // Detailed teacher introduction
  // Appears in "About Me" section
  aboutMe String? @db.Text

  // Short qualification summary
  // Examples:
  // BSc (Hons) Mathematics, PGDE
  // BSc Engineering, MSc Data Science
  qualificationSummary String? @db.Text

  // Total teaching experience in years
  // Example: 8
  yearsOfExperience Int?

  // Contact information
  phone    String?
  whatsapp String?

  // Location
  // Example:
  // District = Colombo
  // City = Maharagama
  districtId Int?
  cityId     Int?

  district District? @relation(fields: [districtId], references: [id])
  city     City?     @relation(fields: [cityId], references: [id])

  // Social media & website links
  facebookUrl  String?
  youtubeUrl   String?
  tiktokUrl    String?
  instagramUrl String?
  websiteUrl   String?

  // SEO metadata for public profile page
  // Example:
  // Best Mathematics Teacher in Colombo
  seoTitle String?

  // Example:
  // Experienced Mathematics Teacher conducting
  // Grade 6-11 classes in Sinhala and English mediums.
  seoDescription String?

  // Platform verification badge
  // Shows:
  // ✓ Verified Teacher
  isVerified Boolean @default(false)

  // Controls public visibility
  // true  = profile visible
  // false = profile hidden
  isPublic Boolean @default(true)

  // Per-section visibility on the public profile.
  // The teacher toggles these from their own profile page; when false the
  // section is hidden from non-teacher (public) visitors but stays visible
  // to the teacher.
  isDisplayQualification Boolean @default(true)
  isDisplayAchievements  Boolean @default(true)
  isDisplaySubjects      Boolean @default(true)
  // Master switch for Payment Details (TeacherPaymentAccount): false hides
  // every account from public visitors and students, whatever each account's
  // own isPublic flag says.
  isDisplayPaymentDetails Boolean @default(true)

  // Number of visits to public profile page
  profileViewCount Int @default(0)

  // Qualifications
  // Examples:
  // BSc (Hons) Mathematics
  // PG Diploma in Education
  qualifications TeacherQualification[]

  // Achievements
  // Examples:
  // Best Teacher Award 2025
  // 100% A Pass Rate
  achievements TeacherAchievement[]

  // Teaching mediums
  // Examples:
  // Sinhala
  // English
  // Tamil
  mediums TeacherProfileMedium[]

  subjects TeacherProfileSubject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([districtId])
  @@index([cityId])
}

model Medium {
  id   Int    @id @default(autoincrement())
  name String @unique

  teachers TeacherProfileMedium[]
}

model TeacherProfileMedium {
  id String @id @default(uuid())

  profileId String
  mediumId  Int

  profile TeacherProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  medium  Medium         @relation(fields: [mediumId], references: [id])

  @@unique([profileId, mediumId])
}

model TeacherQualification {
  id String @id @default(uuid())

  profileId String

  title String

  displayOrder Int @default(0)

  profile TeacherProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model TeacherAchievement {
  id String @id @default(uuid())

  profileId String

  title       String
  description String?

  imageName String?

  displayOrder Int @default(0)

  year Int?

  profile TeacherProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Subject {
  id   Int    @id @default(autoincrement())
  name String @unique

  teachers TeacherProfileSubject[]
}

enum TeachingLevel {
  PRIMARY
  OL
  AL
}

model TeacherProfileSubject {
  id String @id @default(uuid())

  profileId String
  subjectId Int

  teachingLevel TeachingLevel

  profile TeacherProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  subject Subject        @relation(fields: [subjectId], references: [id])

  @@unique([profileId, subjectId, teachingLevel])
}

