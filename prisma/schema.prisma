model YouTubeRecording {
  id String @id @default(uuid())

  lectureId String
  lecture   Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)

  broadcastId String @unique
  videoId     String
  youtubeUrl  String

  privacy YouTubePrivacy         @default(UNLISTED)
  status  YouTubeBroadcastStatus @default(READY)

  visibility RecordingVisibility @default(PRIVATE)
  access     RecordingAccess     @default(LOCKED)

  startedAt DateTime?
  endedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Row version for failed-start cleanup: 0 when a start creates the row,
  /// incremented only when a start reuses or reactivates it; the cleanup of a
  /// failed start closes the row only at the version that start observed.
  version Int @default(0)

  /// Teacher-departure stop (see YouTubeFeatureStopReason). stopReason is set
  /// only in the same update that ends the row after YouTube confirmed it;
  /// the end time is endedAt. autoStopAttemptedAt: when the departure stop
  /// last SENT YouTube a `complete` transition for this row's broadcast
  /// (written just before sending; null: none sent). autoStopError: why the
  /// row is still active ("timeout" = that transition got no answer and may
  /// still be applied; "youtube", "reauth-required", "shared-broadcast").
  stopReason               YouTubeFeatureStopReason?
  autoStopAttemptedAt      DateTime?
  autoStopError            String?
  /// When the current feature generation started (database clock): set when
  /// a start creates, reuses or reactivates the row, which also clears every
  /// departure field above and below. A teacher-departure stop covers the
  /// row only if this is before its tab-close signal (null: older rows, then
  /// createdAt).
  generationStartedAt      DateTime?
  /// When the departure stop last looked the broadcast up on YouTube (its
  /// retry schedule; nothing else writes it).
  autoStopCheckedAt        DateTime?
  /// How many `complete` transitions the departure stop sent for this
  /// generation, and the last failure seen (diagnostics; "unresolved" in
  /// autoStopError once automatic retries gave up).
  autoStopSendCount        Int                       @default(0)
  autoStopLastError        String?
  /// A YouTube `complete` transition was requested for THIS row's broadcast
  /// (broadcastId) and YouTube has not yet been seen to end it: set before
  /// every such request (teacher-departure stop, Stop, failed-start cleanup)
  /// on every row of the broadcast, kept through new generations, cleared
  /// only when a fresh lookup reports the broadcast complete / revoked. While
  /// set, no start reuses or shares the broadcast (YouTube may still apply
  /// the request). No time limit.
  completeRequestedAt      DateTime?
  /// When the teacher dismissed the notice about a stop with a stopReason
  /// (null: not yet, the notice still shows on their return).
  stopNoticeAcknowledgedAt DateTime?

  @@index([lectureId])
}

/// Why the app ended a Recording / Live on its own. Null: ended as before
/// (the teacher's Stop, End Session, a failed-start cleanup or a
/// reconciliation).
/// - TEACHER_LEFT: the class's teacher closed the classroom tab (a confirmed
///   tab-close signal, ClassSession.teacherDepartureAt) and the feature ended
///   because of it. Only the YouTube broadcast was ended: Jibri may still be
///   streaming that classroom.
/// - YOUTUBE_ENDED: YouTube ended the broadcast on its own (e.g. auto-stop
///   after the stream stopped); endedAt is YouTube's actualEndTime. Becomes
///   TEACHER_LEFT only if it ended after a confirmed tab-close signal.
enum YouTubeFeatureStopReason {
  TEACHER_LEFT
  YOUTUBE_ENDED
}

enum RecordingVisibility {
  PUBLIC
  PRIVATE
}

enum RecordingAccess {
  FREE
  LOCKED
}

model YouTubeLiveBroadcast {
  id String @id @default(uuid())

  lectureId String
  lecture   Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)

  broadcastId String @unique
  videoId     String
  youtubeUrl  String

  privacy YouTubePrivacy         @default(UNLISTED)
  status  YouTubeBroadcastStatus @default(READY)

  startedAt DateTime?
  endedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Row version for failed-start cleanup: 0 when a start creates the row,
  /// incremented only when a start reuses or reactivates it; the cleanup of a
  /// failed start closes the row only at the version that start observed.
  version Int @default(0)

  /// Teacher-departure stop: as on YouTubeRecording.
  stopReason               YouTubeFeatureStopReason?
  autoStopAttemptedAt      DateTime?
  autoStopError            String?
  generationStartedAt      DateTime?
  autoStopCheckedAt        DateTime?
  autoStopSendCount        Int                       @default(0)
  autoStopLastError        String?
  /// See YouTubeRecording.completeRequestedAt.
  completeRequestedAt      DateTime?
  stopNoticeAcknowledgedAt DateTime?

  @@index([lectureId])
}

/// Short-lived per-lecture lock around YouTube Recording / Live start, stop
/// and failed-start cleanup, so two requests for the same lecture (two tabs,
/// two devices, two server processes) cannot interleave and create duplicate
/// broadcasts or both decide to start Jibri. One row per lecture while an
/// operation runs; deleted by its owner when done. A crashed holder cannot
/// block the lecture: an expired row is taken over atomically.
model YouTubeOperationLock {
  lectureId String   @id
  ownerId   String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum YouTubePrivacy {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum YouTubeBroadcastStatus {
  CREATED
  READY
  TESTING
  LIVE
  COMPLETE
  REVOKED
  UNKNOWN
}

