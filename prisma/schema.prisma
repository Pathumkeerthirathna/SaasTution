generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Teacher {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  profile TeacherProfile?

  youtubeConnection YouTubeConnection?

  classes                Class[]
  students               Student[]
  confirmedClassPayments ClassPayment[]        @relation("ClassPaymentConfirmedBy")
  paperSupportMessages   PaperSupportMessage[]
  paymentMessages        PaymentMessage[]
  paperConfig            TeacherPaperConfig?

  approvedStudents Student[] @relation("ConfirmedStudents")

  approvedDevices StudentDevice[] @relation("ApprovedDevices")

  @@index([createdAt])
}

model YouTubeConnection {
  id       String @id @default(uuid())

  teacherId String  @unique
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  // YouTube channel information
  channelId    String
  channelTitle String?

  // OAuth credential
  // Store the encrypted refresh token here.
  refreshTokenEncrypted String @db.Text

  // Reusable YouTube Live Stream resource
  // One stream per teacher, reused for future classes.
  liveStreamId String?

  status YouTubeConnectionStatus @default(CONNECTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([channelId])
}

enum YouTubeConnectionStatus {
  CONNECTED
  REAUTH_REQUIRED
}

model District {
  id   Int    @id @default(autoincrement())
  name String @unique

  cities City[]

  teacherProfiles TeacherProfile[]
}

model City {
  id         Int @id @default(autoincrement())
  districtId Int

  name String

  district District @relation(fields: [districtId], references: [id])

  teacherProfiles TeacherProfile[]

  @@unique([districtId, name])
}

model TeacherProfile {
  id String @id @default(uuid())

  // Owner teacher account
  teacherId String  @unique
  teacher   Teacher @relation(fields: [teacherId], references: [id])

  // Public profile URL
  // Example:
  // slclassroom.live/pathum-kumara
  // slclassroom.live/sarah-wickramasinghe
  slug String @unique

  // Profile images
  profileImageUrl String?
  coverImageUrl   String?

  // Professional title shown under teacher name
  // Examples:
  // Mathematics Teacher
  // Physics Lecturer
  // Combined Maths Instructor
  // ICT Tutor
  designation String?

  // Short marketing headline
  // Examples:
  // Helping students achieve A passes in Mathematics
  // Building strong foundations for O/L Science
  // 8+ years guiding students to exam success
  headline String?

  // Detailed teacher introduction
  // Appears in "About Me" section
  aboutMe String? @db.Text

  // Short qualification summary
  // Examples:
  // BSc (Hons) Mathematics, PGDE
  // BSc Engineering, MSc Data Science
  qualificationSummary String? @db.Text

  // Total teaching experience in years
  // Example: 8
  yearsOfExperience Int?

  // Contact information
  phone    String?
  whatsapp String?

  // Location
  // Example:
  // District = Colombo
  // City = Maharagama
  districtId Int?
  cityId     Int?

  district District? @relation(fields: [districtId], references: [id])
  city     City?     @relation(fields: [cityId], references: [id])

  // Social media & website links
  facebookUrl  String?
  youtubeUrl   String?
  tiktokUrl    String?
  instagramUrl String?
  websiteUrl   String?

  // SEO metadata for public profile page
  // Example:
  // Best Mathematics Teacher in Colombo
  seoTitle String?

  // Example:
  // Experienced Mathematics Teacher conducting
  // Grade 6-11 classes in Sinhala and English mediums.
  seoDescription String?

  // Platform verification badge
  // Shows:
  // ✓ Verified Teacher
  isVerified Boolean @default(false)

  // Controls public visibility
  // true  = profile visible
  // false = profile hidden
  isPublic Boolean @default(true)

  // Number of visits to public profile page
  profileViewCount Int @default(0)

  // Qualifications
  // Examples:
  // BSc (Hons) Mathematics
  // PG Diploma in Education
  qualifications TeacherQualification[]

  // Achievements
  // Examples:
  // Best Teacher Award 2025
  // 100% A Pass Rate
  achievements TeacherAchievement[]

  // Teaching mediums
  // Examples:
  // Sinhala
  // English
  // Tamil
  mediums TeacherProfileMedium[]

  subjects TeacherProfileSubject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([districtId])
  @@index([cityId])
}

model Medium {
  id   Int    @id @default(autoincrement())
  name String @unique

  teachers TeacherProfileMedium[]
}

model TeacherProfileMedium {
  id String @id @default(uuid())

  profileId String
  mediumId  Int

  profile TeacherProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  medium  Medium         @relation(fields: [mediumId], references: [id])

  @@unique([profileId, mediumId])
}

model TeacherQualification {
  id String @id @default(uuid())

  profileId String

  title     String
  institute String

  startYear Int?
  endYear   Int?

  displayOrder Int @default(0)

  profile TeacherProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model TeacherAchievement {
  id String @id @default(uuid())

  profileId String

  title       String
  description String?

  displayOrder Int @default(0)

  year Int?

  profile TeacherProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Subject {
  id   Int    @id @default(autoincrement())
  name String @unique

  teachers TeacherProfileSubject[]
}

model TeacherProfileSubject {
  id String @id @default(uuid())

  profileId String
  subjectId Int

  gradeFrom Int?
  gradeTo   Int?

  profile TeacherProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  subject Subject        @relation(fields: [subjectId], references: [id])

  @@unique([profileId, subjectId])
}

//
enum StudentRegistrationSource {
  TEACHER
  PUBLIC_CLASS
  IMPORT
  ADMIN
}

enum StudentConfirmationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StudentDeviceStatus {
  PENDING
  APPROVED
  BLOCKED
}

enum LoginResult {
  SUCCESS
  FAILED
  BLOCKED_DEVICE
  PENDING_DEVICE
  INVALID_PASSWORD
}

//

model Student {
  id                 String   @id @default(uuid())
  name               String
  teacherId          String
  createdAt          DateTime @default(now())
  contact            String
  registrationNumber String?

  status          Int       @default(0) // 0=Active, 1=Inactive, 2=Deleted
  actionTakenDate DateTime?

  gradeId Int?   @default(6)
  grade   Grade? @relation(fields: [gradeId], references: [id])

  contact01 String?
  contact02 String?
  email     String?
  password  String?

  publicClassId String?
  publicClass   Class?  @relation("PublicClassRegistration", fields: [publicClassId], references: [id])

  registrationSource StudentRegistrationSource @default(TEACHER)

  confirmationStatus StudentConfirmationStatus @default(PENDING)

  confirmedAt   DateTime?
  confirmedById String?
  confirmedBy   Teacher?  @relation("ConfirmedStudents", fields: [confirmedById], references: [id])

  registeredAt DateTime @default(now())

  devices      StudentDevice[]
  loginHistory StudentLoginHistory[]

  submissions                   AssignmentSubmission[]
  attendance                    Attendance[]
  classPayments                 ClassPayment[]
  classes                       ClassStudent[]
  classHistory                  ClassStudentHistory[]
  guardians                     Guardian[]
  materialBundleItemSubmissions MaterialBundleItemSubmission[]
  materialBundleRecipients      MaterialBundleRecipient[]
  deliveries                    MessageDelivery[]
  paperSupportMessages          PaperSupportMessage[]
  paymentMessages               PaymentMessage[]
  quizSubmissions               QuizSubmission[]
  teacher                       Teacher                        @relation(fields: [teacherId], references: [id])

  @@index([teacherId])
  @@index([registrationSource])
  @@index([confirmationStatus])
  @@index([publicClassId])
}

model StudentDevice {

  id String @id @default(uuid())

  studentId String
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  deviceId String

  deviceModel String?
  deviceName String?

  browser String?
  browserVersion String?

  fingerprint String?

  os String?
  osVersion String?

  platform String?

  userAgent String?

  lastIpAddress String?

  country String?
  city String?

  status StudentDeviceStatus @default(PENDING)

  firstLoginAt DateTime @default(now())
  lastLoginAt DateTime?

  approvalRequestedAt DateTime @default(now())
  approvedAt DateTime?
  rejectedAt DateTime?

  approvedReason String?
  rejectedReason String?

  approvalRequestMessage String?

  approvalRequestedByStudentAt DateTime?

  approvedByTeacherId String?
  approvedByTeacher Teacher?@relation("ApprovedDevices", fields: [approvedByTeacherId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  loginHistory StudentLoginHistory[]

  @@index([studentId])
  @@index([status])
  @@index([approvedByTeacherId])
  @@index([approvalRequestedAt])
  @@unique([studentId, deviceId])

}

model StudentLoginHistory {
  id String @id @default(uuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  deviceId String?
  device   StudentDevice? @relation(fields: [deviceId], references: [id])

  ipAddress String?

  userAgent String?

  result LoginResult

  loggedAt DateTime @default(now())

  country String?

  city String?

  @@index([studentId])
  @@index([loggedAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  role      Role
  userId    String
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([role, userId])
  @@index([expiresAt])
}

model Guardian {
  id        String   @id @default(uuid())
  name      String
  relation  String
  phone     String
  studentId String
  email     String?  @unique
  password  String?
  createdAt DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id])

  @@index([studentId])
}

model Class {
  id                   String                @id @default(uuid())
  name                 String
  description          String?
  teacherId            String
  createdAt            DateTime              @default(now())
  startDate            DateTime?
  status               Int                   @default(0)
  schedule             String                @default("TBD")
  monthlyFee           Int                   @default(0)
  paymentDueWeek       Int                   @default(1)
  teacher              Teacher               @relation(fields: [teacherId], references: [id])
  payments             ClassPayment[]
  schedules            ClassSchedule[]
  sessions             ClassSession[]
  students             ClassStudent[]
  studentHistory       ClassStudentHistory[]
  lectures             Lecture[]
  materialBundles      MaterialBundle[]
  messages             Message[]
  paperSupportMessages PaperSupportMessage[]

  publicRegistrations Student[] @relation("PublicClassRegistration")

  @@index([teacherId, createdAt])
}

model TeacherPaperConfig {
  id                     String   @id @default(uuid())
  teacherId              String   @unique
  countdownLeadMinutes   Int      @default(30)
  submissionGraceMinutes Int      @default(20)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  teacher                Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model MaterialBundle {
  id                   String                    @id @default(uuid())
  classId              String
  year                 Int
  month                Int
  status               MaterialBundleStatus      @default(DRAFT)
  sentAt               DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  title                String
  class                Class                     @relation(fields: [classId], references: [id], onDelete: Cascade)
  items                MaterialBundleItem[]
  recipients           MaterialBundleRecipient[]
  paperSupportMessages PaperSupportMessage[]

  @@index([classId, year, month])
  @@index([status, sentAt])
}

model MaterialBundleItem {
  id                   String                         @id @default(uuid())
  bundleId             String
  type                 MaterialBundleItemType
  title                String
  description          String?
  fileName             String?
  fileUrl              String?
  mimeType             String?
  sizeBytes            Int?
  paperStartAt         DateTime?
  paperEndAt           DateTime?
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt
  bundle               MaterialBundle                 @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  submissions          MaterialBundleItemSubmission[]
  paperSupportMessages PaperSupportMessage[]

  @@index([bundleId, type, createdAt])
}

model PaperSupportMessage {
  id        String             @id @default(uuid())
  bundleId  String
  itemId    String
  classId   String
  teacherId String
  studentId String
  message   String
  createdAt DateTime           @default(now())
  bundle    MaterialBundle     @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  class     Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  item      MaterialBundleItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  student   Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher   Teacher            @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt])
  @@index([studentId, createdAt])
  @@index([teacherId, createdAt])
  @@index([classId, createdAt])
}

model MaterialBundleItemSubmission {
  id          String             @id @default(uuid())
  itemId      String
  studentId   String
  fileName    String
  fileUrl     String
  mimeType    String
  sizeBytes   Int
  submittedAt DateTime           @default(now())
  createdAt   DateTime           @default(now())
  item        MaterialBundleItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  student     Student            @relation(fields: [studentId], references: [id])

  @@index([itemId, studentId, submittedAt])
  @@index([studentId, submittedAt])
}

model MaterialBundleRecipient {
  id          String         @id @default(uuid())
  bundleId    String
  studentId   String
  willReceive Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  receivedAt  DateTime?
  bundle      MaterialBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  student     Student        @relation(fields: [studentId], references: [id])

  @@unique([bundleId, studentId])
  @@index([studentId, willReceive])
}

model ClassSchedule {
  id        String   @id @default(uuid())
  classId   String
  dayOfWeek Weekday
  startTime String
  endTime   String
  createdAt DateTime @default(now())
  class     Class    @relation(fields: [classId], references: [id])

  @@index([classId, dayOfWeek])
}

model ClassSession {
  id          String       @id @default(uuid())
  classId     String
  roomName    String       @unique
  jitsiDomain String       @default("meet.jit.si")
  startedAt   DateTime     @default(now())
  endedAt     DateTime?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  lectureId   String?
  attendance  Attendance[]
  class       Class        @relation(fields: [classId], references: [id])
  lecture     Lecture?     @relation(fields: [lectureId], references: [id])

  @@index([classId, isActive])
  @@index([classId, isActive, startedAt])
  @@index([lectureId, startedAt])
}

model ClassStudent {
  id           String    @id @default(uuid())
  classId      String
  studentId    String
  isActive     Boolean   @default(true)
  assignedAt   DateTime  @default(now())
  removedAt    DateTime?
  removeReason String?
  class        Class     @relation(fields: [classId], references: [id])
  student      Student   @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@index([classId, isActive])
}

model ClassStudentHistory {
  id         String             @id @default(uuid())
  classId    String
  studentId  String
  action     StudentClassAction
  actionDate DateTime           @default(now())
  reason     String?

  class   Class   @relation(fields: [classId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@index([classId])
  @@index([studentId])
}

model Lecture {
  id          String         @id @default(uuid())
  title       String
  date        DateTime
  classId     String
  createdAt   DateTime       @default(now())

  assignments Assignment[]
  sessions    ClassSession[]
  class       Class          @relation(fields: [classId], references: [id])
  notes       Note[]
  quizzes     Quiz[]

  youtubeRecordings YouTubeRecording[]
  youtubeLives      YouTubeLiveBroadcast[]

  @@index([classId, date])
}
model YouTubeRecording {
  id String @id @default(uuid())

  lectureId String
  lecture   Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)

  broadcastId String @unique
  videoId     String
  youtubeUrl  String

  privacy YouTubePrivacy @default(UNLISTED)
  status  YouTubeBroadcastStatus @default(READY)

  startedAt DateTime?
  endedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lectureId])
}

model YouTubeLiveBroadcast {
  id String @id @default(uuid())

  lectureId String
  lecture   Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)

  broadcastId String @unique
  videoId     String
  youtubeUrl  String

  privacy YouTubePrivacy @default(UNLISTED)
  status  YouTubeBroadcastStatus @default(READY)

  startedAt DateTime?
  endedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lectureId])
}

enum YouTubePrivacy {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum YouTubeBroadcastStatus {
  CREATED
  READY
  TESTING
  LIVE
  COMPLETE
  REVOKED
  UNKNOWN
}

model Note {
  id               String    @id @default(uuid())
  title            String
  fileUrl          String
  lectureId        String
  kind             NoteKind  @default(NOTE)
  mimeType         String
  sizeBytes        Int
  downloadCount    Int       @default(0)
  lastDownloadedAt DateTime?
  lecture          Lecture   @relation(fields: [lectureId], references: [id])

  @@index([lectureId])
}

model Assignment {
  id          String                 @id @default(uuid())
  title       String
  description String
  dueDate     DateTime
  lectureId   String
  lecture     Lecture                @relation(fields: [lectureId], references: [id])
  submissions AssignmentSubmission[]

  @@index([lectureId, dueDate])
}

model AssignmentSubmission {
  id           String     @id @default(uuid())
  assignmentId String
  studentId    String
  notes        String?
  submittedAt  DateTime   @default(now())
  fileName     String
  fileUrl      String
  mimeType     String
  sizeBytes    Int
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      Student    @relation(fields: [studentId], references: [id])

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@index([assignmentId])
}

model Quiz {
  id          String           @id @default(uuid())
  title       String
  lectureId   String
  dueDate     DateTime?
  maxAttempts Int?
  lecture     Lecture          @relation(fields: [lectureId], references: [id])
  questions   QuizQuestion[]
  submissions QuizSubmission[]

  @@index([lectureId])
}

model QuizQuestion {
  id                String                 @id @default(uuid())
  quizId            String
  text              String
  orderIndex        Int
  answerType        QuizAnswerType
  quiz              Quiz                   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options           QuizQuestionOption[]
  submissionAnswers QuizSubmissionAnswer[]

  @@index([quizId, orderIndex])
}

model QuizQuestionOption {
  id         String       @id @default(uuid())
  questionId String
  text       String
  isCorrect  Boolean      @default(false)
  orderIndex Int
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, orderIndex])
}

model QuizSubmission {
  id             String                 @id @default(uuid())
  quizId         String
  studentId      String
  score          Int
  totalQuestions Int
  submittedAt    DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  attemptCount   Int                    @default(1)
  quiz           Quiz                   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student        Student                @relation(fields: [studentId], references: [id])
  answers        QuizSubmissionAnswer[]

  @@unique([quizId, studentId])
  @@index([studentId])
  @@index([quizId])
}

model QuizSubmissionAnswer {
  id                String         @id @default(uuid())
  submissionId      String
  questionId        String
  selectedOptionIds String[]
  isCorrect         Boolean
  question          QuizQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  submission        QuizSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, questionId])
  @@index([questionId])
}

model Attendance {
  id             String       @id @default(uuid())
  studentId      String
  classId        String
  joinedAt       DateTime     @default(now())
  classSessionId String
  leftAt         DateTime?
  classSession   ClassSession @relation(fields: [classSessionId], references: [id])
  student        Student      @relation(fields: [studentId], references: [id])

  @@index([classId])
  @@index([classId, joinedAt])
  @@index([classSessionId])
  @@index([classSessionId, joinedAt])
  @@index([classSessionId, studentId, joinedAt])
}

model Message {
  id         String            @id @default(uuid())
  content    String
  classId    String
  createdAt  DateTime          @default(now())
  class      Class             @relation(fields: [classId], references: [id])
  deliveries MessageDelivery[]

  @@index([classId, createdAt])
}

model MessageDelivery {
  id                String                @id @default(uuid())
  messageId         String
  studentId         String
  status            MessageDeliveryStatus @default(QUEUED)
  provider          String?
  providerMessageId String?
  error             String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  message           Message               @relation(fields: [messageId], references: [id])
  student           Student               @relation(fields: [studentId], references: [id])

  @@unique([messageId, studentId])
  @@index([messageId, createdAt])
  @@index([messageId, status])
  @@index([providerMessageId])
}

model ClassPayment {
  id                   String             @id @default(uuid())
  classId              String
  studentId            String
  month                String
  amount               Int
  note                 String?
  slipFileName         String?
  slipFileUrl          String?
  slipMimeType         String?
  slipSizeBytes        Int?
  status               ClassPaymentStatus @default(PENDING)
  teacherFeedback      String?
  submittedAt          DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  confirmedAt          DateTime?
  confirmedByTeacherId String?
  class                Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  confirmedByTeacher   Teacher?           @relation("ClassPaymentConfirmedBy", fields: [confirmedByTeacherId], references: [id])
  student              Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  messages             PaymentMessage[]

  @@unique([classId, studentId, month])
  @@index([studentId, month])
  @@index([classId, month, status])
}

model PaymentMessage {
  id             String               @id @default(uuid())
  paymentId      String
  senderRole     PaymentMessageSender
  studentId      String?
  teacherId      String?
  message        String
  proofFileName  String?
  proofFileUrl   String?
  proofMimeType  String?
  proofSizeBytes Int?
  createdAt      DateTime             @default(now())
  payment        ClassPayment         @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  student        Student?             @relation(fields: [studentId], references: [id])
  teacher        Teacher?             @relation(fields: [teacherId], references: [id])

  @@index([paymentId, createdAt])
}

model Grade {
  id        Int    @id @default(autoincrement())
  GradeDesc String
  Status    Int    @default(0)

  students Student[]
}

enum Role {
  TEACHER
  STUDENT
  GUARDIAN
  ADMIN
}

enum MessageDeliveryStatus {
  QUEUED
  SENT
  FAILED
}

enum NoteKind {
  NOTE
  SUPPORTING_MATERIAL
}

enum Weekday {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum QuizAnswerType {
  SINGLE
  MULTIPLE
}

enum MaterialBundleStatus {
  DRAFT
  SENT
}

enum MaterialBundleItemType {
  TUTE
  PAPER
}

enum ClassPaymentStatus {
  PENDING
  CONFIRMED
  NEEDS_CLARIFICATION
}

enum PaymentMessageSender {
  STUDENT
  TEACHER
}

enum StudentClassAction {
  ASSIGNED
  UNASSIGNED
}
