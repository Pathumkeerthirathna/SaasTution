enum StudentRegistrationSource {
  TEACHER
  PUBLIC_CLASS
  IMPORT
  ADMIN
}

enum StudentConfirmationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// How a teacher made a confirmation decision.
enum StudentConfirmationSource {
  /// Confirm / Decline / Confirm again on one student.
  INDIVIDUAL
  /// "Confirm all pending" (always PENDING -> APPROVED, one batchId per run).
  BULK
}

/// Append-only history of teacher approval decisions on students
/// (docs/student-confirmation-history.md). One row per real change of
/// Student.confirmationStatus, written in the same transaction as the change
/// (services/student-service.ts). Decisions made before this table existed
/// were not backfilled. CHECK constraints and the trigger that refuses
/// UPDATE / DELETE are hand-written in migration
/// 20261110130000_add_student_confirmation_history.
model StudentConfirmationHistory {
  id                  String                    @id @default(uuid())
  studentId           String
  fromStatus          StudentConfirmationStatus
  toStatus            StudentConfirmationStatus
  /// Real UTC instant; equals the Student.confirmedAt written with this row.
  decidedAt           DateTime
  /// Student.confirmedAt before this decision (read under the row lock).
  previousConfirmedAt DateTime?
  decidedByTeacherId  String
  source              StudentConfirmationSource
  /// Shared by every row of one bulk approval; null for INDIVIDUAL.
  batchId             String?

  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  teacher Teacher @relation(fields: [decidedByTeacherId], references: [id], onDelete: Restrict)

  @@index([studentId, decidedAt])
}

enum StudentDeviceStatus {
  PENDING
  APPROVED
  BLOCKED
}

enum LoginResult {
  SUCCESS
  FAILED
  BLOCKED_DEVICE
  PENDING_DEVICE
  INVALID_PASSWORD
}

//

model Student {
  id                 String   @id @default(uuid())
  name               String
  teacherId          String
  createdAt          DateTime @default(now())
  contact            String
  registrationNumber String?

  status             Int       @default(0) // 0=Active, 1=Inactive, 2=Deleted
  actionTakenDate    DateTime?
  deactivationReason String?

  gradeId Int?   @default(6)
  grade   Grade? @relation(fields: [gradeId], references: [id])

  contact01 String?
  contact02 String?
  email     String?
  password  String?

  /// Student session invalidation (Student Profile SP-5): student JWTs carry
  /// this value as the `sv` claim (a token without it counts as 0); raising it
  /// invalidates every other student session. Teachers / guardians do not use it.
  sessionVersion Int @default(0)

  publicClassId String?
  publicClass   Class?  @relation("PublicClassRegistration", fields: [publicClassId], references: [id])

  registrationSource StudentRegistrationSource @default(TEACHER)

  confirmationStatus StudentConfirmationStatus @default(PENDING)

  /// Time of the LATEST teacher decision (approve or decline); null when no
  /// decision was ever made (e.g. created already approved, or still pending).
  confirmedAt   DateTime?
  /// Teacher who made the latest decision; null when no teacher decided.
  confirmedById String?
  confirmedBy   Teacher?  @relation("ConfirmedStudents", fields: [confirmedById], references: [id])

  /// First transition to APPROVED (real UTC instant). Set once; never
  /// cleared or overwritten by a rejection or a later re-approval.
  /// Used by the automatic joining fee waiver (services/class-fee-waiver-service.ts).
  approvedAt DateTime?

  // Email ownership confirmation via a one-time code. A student cannot log
  // in until this is true.
  emailConfirmed   Boolean   @default(false)
  emailConfirmedAt DateTime?

  /// The student's password is a system-generated TEMPORARY password (emailed
  /// at registration) and the optional "Secure Your Account" step has not been
  /// answered yet. Cleared when the student sets their own password (first
  /// login, account security or Forgot Password) or skips the step. Existing
  /// students: false (never prompted). Migration 20261118120000.
  passwordSetupPending Boolean @default(false)

  registeredAt DateTime @default(now())

  devices      StudentDevice[]
  loginHistory StudentLoginHistory[]

  submissions                   AssignmentSubmission[]
  attendance                    Attendance[]
  classPayments                 ClassPayment[]
  classes                       ClassStudent[]
  classHistory                  ClassStudentHistory[]
  guardianLinks                 GuardianStudent[]
  materialBundleItemSubmissions MaterialBundleItemSubmission[]
  materialBundleRecipients      MaterialBundleRecipient[]
  deliveries                    MessageDelivery[]
  paperSupportMessages          PaperSupportMessage[]
  paymentMessages               PaymentMessage[]
  quizSubmissions               QuizSubmission[]
  classPaperSubmissions         ClassPaperStudent[]
  noteViews                     NoteStudent[]
  breakoutAssignmentDrafts      BreakoutAssignmentDraft[]
  breakoutAssignmentSubmissions BreakoutAssignmentSubmission[]
  breakoutQuizSubmissions       BreakoutQuizSubmission[]
  breakoutRoomMemberships       BreakoutRoomMember[]
  qrTokens                      StudentQrToken[]
  confirmationHistory           StudentConfirmationHistory[]
  emailDeliveries               EmailDelivery[]
  lectureAttendances            LectureAttendance[]
  attendanceScanEvents          AttendanceScanEvent[]
  teacher                       Teacher                        @relation(fields: [teacherId], references: [id])

  @@index([teacherId])
  @@index([registrationSource])
  @@index([confirmationStatus])
  @@index([publicClassId])
}

/// Why a StudentQrToken row was created.
enum StudentQrTokenReason {
  /// First token of a student (issued lazily on first QR view).
  ISSUE
  /// Replacement requested by the student or the owning teacher (limited).
  REGENERATE
  /// Replacement made by an explicit administrative operation (e.g. after a
  /// STUDENT_QR_SECRET rotation). Never created during normal QR rendering.
  SYSTEM_REISSUE
}

/// A student's QR identity token (docs/student-qr-identity.md).
///
/// The QR token itself is NEVER stored. It is derived on demand as
/// HMAC-SHA256(STUDENT_QR_SECRET, "slc-student-qr:v1:" + id + ":" + nonce)
/// and only its SHA-256 hash is kept, for lookups. At most one active
/// (revokedAt IS NULL) token per student, enforced by a hand-written partial
/// unique index in the migration. createdAt / revokedAt are written by the
/// application as real UTC instants (no database default).
model StudentQrToken {
  id            String               @id @default(uuid())
  studentId     String
  /// Random per-token value (base64url, 32 bytes) used in the derivation.
  nonce         String
  /// SHA-256 (hex) of the derived token.
  tokenHash     String               @unique
  reason        StudentQrTokenReason
  createdAt     DateTime
  /// STUDENT | TEACHER | SYSTEM (CHECK constraint in the migration).
  createdByRole String
  createdById   String?
  revokedAt     DateTime?
  /// Revocation audit: all three are NULL while active and set together with
  /// revokedAt (CHECK constraints in the migration).
  /// STUDENT | TEACHER | SYSTEM.
  revokedByRole String?
  /// Required unless revokedByRole = SYSTEM.
  revokedById   String?
  /// REGENERATE (by STUDENT / TEACHER) | SYSTEM_REISSUE (by SYSTEM).
  revokedReason String?
  student       Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attendanceScans AttendanceScanEvent[]

  @@index([studentId, createdAt])
  @@index([studentId, revokedAt])
}

model StudentDevice {
  id String @id @default(uuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  deviceId String

  deviceModel String?
  deviceName  String?

  browser        String?
  browserVersion String?

  fingerprint String?

  os        String?
  osVersion String?

  platform String?

  userAgent String?

  lastIpAddress String?

  country String?
  city    String?

  status StudentDeviceStatus @default(PENDING)

  firstLoginAt DateTime  @default(now())
  lastLoginAt  DateTime?

  approvalRequestedAt DateTime  @default(now())
  approvedAt          DateTime?
  rejectedAt          DateTime?

  approvedReason String?
  rejectedReason String?

  approvalRequestMessage String?

  approvalRequestedByStudentAt DateTime?

  approvedByTeacherId String?
  approvedByTeacher   Teacher? @relation("ApprovedDevices", fields: [approvedByTeacherId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  loginHistory StudentLoginHistory[]

  @@unique([studentId, deviceId])
  @@index([studentId])
  @@index([status])
  @@index([approvedByTeacherId])
  @@index([approvalRequestedAt])
}

model StudentLoginHistory {
  id String @id @default(uuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  deviceId String?
  device   StudentDevice? @relation(fields: [deviceId], references: [id])

  ipAddress String?

  userAgent String?

  result LoginResult

  loggedAt DateTime @default(now())

  country String?

  city String?

  @@index([studentId])
  @@index([loggedAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  role      Role
  userId    String
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([role, userId])
  @@index([expiresAt])
}

// A one-time numeric code emailed to a teacher or student to confirm they
// own the email address on their account. Only TEACHER and STUDENT roles
// use this today.
model EmailVerificationCode {
  id        String    @id @default(uuid())
  codeHash  String
  role      Role
  userId    String
  email     String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([role, userId])
  @@index([expiresAt])
}

model Guardian {
  id        String   @id @default(uuid())
  fullName  String   @unique
  email     String   @unique
  phone     String
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students GuardianStudent[]
}

model GuardianStudent {
  id         String   @id @default(uuid())
  guardianId String
  studentId  String
  relation   String
  createdAt  DateTime @default(now())

  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([guardianId, studentId])
  @@index([studentId])
  @@index([guardianId])
}

model Class {
  id                   String                @id @default(uuid())
  name                 String
  description          String?
  teacherId            String
  createdAt            DateTime              @default(now())
  startDate            DateTime?
  status               Int                   @default(0)
  schedule             String                @default("TBD")
  monthlyFee           Int                   @default(0)
