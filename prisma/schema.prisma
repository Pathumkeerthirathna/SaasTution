generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Teacher {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  contact   String?
  createdAt DateTime @default(now())

  // Admin confirmation of a newly registered teacher account.
  isConfirmed Boolean   @default(false)
  confirmedAt DateTime?
  isRejected  Boolean   @default(false)
  rejectedAt  DateTime?

  // Admin-imposed block, with the reason shown to the teacher at login.
  isBlocked   Boolean   @default(false)
  blockedAt   DateTime?
  blockReason String?

  // Email ownership confirmation via a one-time code. A teacher cannot log
  // in until this is true.
  emailConfirmed   Boolean   @default(false)
  emailConfirmedAt DateTime?

  profile TeacherProfile?

  youtubeConnection YouTubeConnection?

  classes                Class[]
  students               Student[]
  confirmedClassPayments ClassPayment[]        @relation("ClassPaymentConfirmedBy")
  paperSupportMessages   PaperSupportMessage[]
  paymentMessages        PaymentMessage[]
  paperConfig            TeacherPaperConfig?

  approvedStudents Student[] @relation("ConfirmedStudents")

  approvedDevices StudentDevice[] @relation("ApprovedDevices")

  announcements TeacherAnnouncement[]

  profileSections TeacherProfileSection[]

  eventTypes     TeacherEventType[]
  calendarEvents TeacherCalendarEvent[]

  subscriptions TeacherSubscription[]

  @@index([createdAt])
}

enum SubscriptionPlanStatus {
  ACTIVE
  INACTIVE
}

enum SubscriptionInterval {
  MONTHLY
  YEARLY
}

model SubscriptionPlan {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  price    Decimal              @db.Decimal(10, 2)
  currency String               @default("LKR")
  interval SubscriptionInterval @default(MONTHLY)

  maxLiveParticipants Int

  unlimitedLiveSessions Boolean @default(true)
  unlimitedRecording    Boolean @default(true)
  unlimitedStudents     Boolean @default(true)

  maxTeachers Int?
  storageGB   Int?

  status    SubscriptionPlanStatus @default(ACTIVE)
  sortOrder Int                    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions TeacherSubscription[]

  @@index([status])
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  SUSPENDED
}

model TeacherSubscription {
  id String @id @default(uuid())

  teacherId String
  planId    String

  status SubscriptionStatus @default(ACTIVE)

  startDate DateTime
  endDate   DateTime?

  price    Decimal @db.Decimal(10, 2)
  currency String  @default("LKR")

  autoRenew Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher Teacher          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  plan    SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([teacherId])
  @@index([planId])
  @@index([status])
}

model TeacherEventType {
  id        Int    @id @default(autoincrement())
  teacherId String

  name        String
  description String?
  color       String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher Teacher                @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  events  TeacherCalendarEvent[]

  @@unique([teacherId, name])
  @@index([teacherId])
}

model TeacherCalendarEvent {
  id Int @id @default(autoincrement())

  teacherId   String
  eventTypeId Int

  title       String
  description String?

  startDateTime DateTime
  endDateTime   DateTime
  isAllDay      Boolean  @default(false)

  location   String?
  meetingUrl String?

  // 0 = active, 1 = removed (soft-deleted). Removed events are hidden everywhere.
  status Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher   Teacher          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  eventType TeacherEventType @relation(fields: [eventTypeId], references: [id])

  @@index([teacherId, status, startDateTime])
  @@index([eventTypeId])
}

enum TeacherProfileSectionType {
  ABOUT_ME
  ANNOUNCEMENTS
  SUBJECTS
  SOCIAL_MEDIA
  QUALIFICATIONS
  ACHIEVEMENTS
}

model TeacherProfileSection {
  id String @id @default(uuid())

  teacherId String

  sectionType TeacherProfileSectionType

  displayOrder Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, sectionType])
  @@unique([teacherId, displayOrder])
  @@index([teacherId])
}

model TeacherAnnouncement {
  id String @id @default(uuid())

  teacherId String

  imageName   String
  description String @db.Text

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([teacherId, sortOrder])
}

model YouTubeConnection {
  id String @id @default(uuid())

  teacherId String  @unique
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  // YouTube channel information
  channelId    String
  channelTitle String?

  // OAuth credential
  // Store the encrypted refresh token here.
  refreshTokenEncrypted String @db.Text

  // Reusable YouTube Live Stream resource
  // One stream per teacher, reused for future classes.
  liveStreamId String?

  status YouTubeConnectionStatus @default(CONNECTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([channelId])
}

enum YouTubeConnectionStatus {
  CONNECTED
  REAUTH_REQUIRED
}

model District {
  id   Int    @id @default(autoincrement())
  name String @unique

  cities City[]

  teacherProfiles TeacherProfile[]
}

model City {
  id         Int @id @default(autoincrement())
  districtId Int

  name String

  district District @relation(fields: [districtId], references: [id])

  teacherProfiles TeacherProfile[]

  @@unique([districtId, name])
}

enum TeacherTitle {
  MR
  MRS
  MS
  DR
  PROF
}

model TeacherProfile {
  id String @id @default(uuid())

  // Owner teacher account
  teacherId String  @unique
  teacher   Teacher @relation(fields: [teacherId], references: [id])

  // Public profile URL
  // Example:
  // slclassroom.live/pathum-kumara
  // slclassroom.live/sarah-wickramasinghe
  slug String @unique

  // Title shown before the teacher's display name
  // Example: Mr. Pathum Kumara
  title TeacherTitle @default(MR)

  // Name shown on the public profile
  // Defaults to the teacher's account name but can be customized
  displayName String?

  // Profile images
  profileImageUrl String?
  coverImageUrl   String?

  // Professional title shown under teacher name
  // Examples:
  // Mathematics Teacher
  // Physics Lecturer
  // Combined Maths Instructor
  // ICT Tutor
  designation String?

  // Short marketing headline
  // Examples:
  // Helping students achieve A passes in Mathematics
  // Building strong foundations for O/L Science
  // 8+ years guiding students to exam success
  headline String?

  // Detailed teacher introduction
  // Appears in "About Me" section
  aboutMe String? @db.Text

  // Short qualification summary
  // Examples:
  // BSc (Hons) Mathematics, PGDE
  // BSc Engineering, MSc Data Science
  qualificationSummary String? @db.Text

  // Total teaching experience in years
  // Example: 8
  yearsOfExperience Int?

  // Contact information
  phone    String?
  whatsapp String?

  // Location
  // Example:
  // District = Colombo
  // City = Maharagama
  districtId Int?
  cityId     Int?

  district District? @relation(fields: [districtId], references: [id])
  city     City?     @relation(fields: [cityId], references: [id])

  // Social media & website links
  facebookUrl  String?
  youtubeUrl   String?
  tiktokUrl    String?
  instagramUrl String?
  websiteUrl   String?

  // SEO metadata for public profile page
  // Example:
  // Best Mathematics Teacher in Colombo
  seoTitle String?

  // Example:
  // Experienced Mathematics Teacher conducting
  // Grade 6-11 classes in Sinhala and English mediums.
  seoDescription String?

  // Platform verification badge
  // Shows:
  // ✓ Verified Teacher
  isVerified Boolean @default(false)

  // Controls public visibility
  // true  = profile visible
  // false = profile hidden
  isPublic Boolean @default(true)

  // Per-section visibility on the public profile.
  // The teacher toggles these from their own profile page; when false the
  // section is hidden from non-teacher (public) visitors but stays visible
  // to the teacher.
  isDisplayQualification Boolean @default(true)
  isDisplayAchievements  Boolean @default(true)
  isDisplaySubjects      Boolean @default(true)

  // Number of visits to public profile page
  profileViewCount Int @default(0)

  // Qualifications
  // Examples:
  // BSc (Hons) Mathematics
  // PG Diploma in Education
  qualifications TeacherQualification[]

  // Achievements
  // Examples:
  // Best Teacher Award 2025
  // 100% A Pass Rate
  achievements TeacherAchievement[]

  // Teaching mediums
  // Examples:
  // Sinhala
  // English
  // Tamil
  mediums TeacherProfileMedium[]

  subjects TeacherProfileSubject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([districtId])
  @@index([cityId])
}

model Medium {
  id   Int    @id @default(autoincrement())
  name String @unique

  teachers TeacherProfileMedium[]
}

model TeacherProfileMedium {
  id String @id @default(uuid())

  profileId String
  mediumId  Int

  profile TeacherProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  medium  Medium         @relation(fields: [mediumId], references: [id])

  @@unique([profileId, mediumId])
}

model TeacherQualification {
  id String @id @default(uuid())

  profileId String

  title String

  displayOrder Int @default(0)

  profile TeacherProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model TeacherAchievement {
  id String @id @default(uuid())

  profileId String

  title       String
  description String?

  imageName String?

  displayOrder Int @default(0)

  year Int?

  profile TeacherProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Subject {
  id   Int    @id @default(autoincrement())
  name String @unique

  teachers TeacherProfileSubject[]
}

enum TeachingLevel {
  PRIMARY
  OL
  AL
}

model TeacherProfileSubject {
  id String @id @default(uuid())

  profileId String
  subjectId Int

  teachingLevel TeachingLevel

  profile TeacherProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  subject Subject        @relation(fields: [subjectId], references: [id])

  @@unique([profileId, subjectId, teachingLevel])
}

//
enum StudentRegistrationSource {
  TEACHER
  PUBLIC_CLASS
  IMPORT
  ADMIN
}

enum StudentConfirmationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StudentDeviceStatus {
  PENDING
  APPROVED
  BLOCKED
}

enum LoginResult {
  SUCCESS
  FAILED
  BLOCKED_DEVICE
  PENDING_DEVICE
  INVALID_PASSWORD
}

//

model Student {
  id                 String   @id @default(uuid())
  name               String
  teacherId          String
  createdAt          DateTime @default(now())
  contact            String
  registrationNumber String?

  status             Int       @default(0) // 0=Active, 1=Inactive, 2=Deleted
  actionTakenDate    DateTime?
  deactivationReason String?

  gradeId Int?   @default(6)
  grade   Grade? @relation(fields: [gradeId], references: [id])

  contact01 String?
  contact02 String?
  email     String?
  password  String?

  publicClassId String?
  publicClass   Class?  @relation("PublicClassRegistration", fields: [publicClassId], references: [id])

  registrationSource StudentRegistrationSource @default(TEACHER)

  confirmationStatus StudentConfirmationStatus @default(PENDING)

  confirmedAt   DateTime?
  confirmedById String?
  confirmedBy   Teacher?  @relation("ConfirmedStudents", fields: [confirmedById], references: [id])

  // Email ownership confirmation via a one-time code. A student cannot log
  // in until this is true.
  emailConfirmed   Boolean   @default(false)
  emailConfirmedAt DateTime?

  registeredAt DateTime @default(now())

  devices      StudentDevice[]
  loginHistory StudentLoginHistory[]

  submissions                   AssignmentSubmission[]
  attendance                    Attendance[]
  classPayments                 ClassPayment[]
  classes                       ClassStudent[]
  classHistory                  ClassStudentHistory[]
  guardianLinks                 GuardianStudent[]
  materialBundleItemSubmissions MaterialBundleItemSubmission[]
  materialBundleRecipients      MaterialBundleRecipient[]
  deliveries                    MessageDelivery[]
  paperSupportMessages          PaperSupportMessage[]
  paymentMessages               PaymentMessage[]
  quizSubmissions               QuizSubmission[]
  classPaperSubmissions         ClassPaperStudent[]
  noteViews                     NoteStudent[]
  teacher                       Teacher                        @relation(fields: [teacherId], references: [id])

  @@index([teacherId])
  @@index([registrationSource])
  @@index([confirmationStatus])
  @@index([publicClassId])
}

model StudentDevice {
  id String @id @default(uuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  deviceId String

  deviceModel String?
  deviceName  String?

  browser        String?
  browserVersion String?

  fingerprint String?

  os        String?
  osVersion String?

  platform String?

  userAgent String?

  lastIpAddress String?

  country String?
  city    String?

  status StudentDeviceStatus @default(PENDING)

  firstLoginAt DateTime  @default(now())
  lastLoginAt  DateTime?

  approvalRequestedAt DateTime  @default(now())
  approvedAt          DateTime?
  rejectedAt          DateTime?

  approvedReason String?
  rejectedReason String?

  approvalRequestMessage String?

  approvalRequestedByStudentAt DateTime?

  approvedByTeacherId String?
  approvedByTeacher   Teacher? @relation("ApprovedDevices", fields: [approvedByTeacherId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  loginHistory StudentLoginHistory[]

  @@unique([studentId, deviceId])
  @@index([studentId])
  @@index([status])
  @@index([approvedByTeacherId])
  @@index([approvalRequestedAt])
}

model StudentLoginHistory {
  id String @id @default(uuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  deviceId String?
  device   StudentDevice? @relation(fields: [deviceId], references: [id])

  ipAddress String?

  userAgent String?

  result LoginResult

  loggedAt DateTime @default(now())

  country String?

  city String?

  @@index([studentId])
  @@index([loggedAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  role      Role
  userId    String
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([role, userId])
  @@index([expiresAt])
}

// A one-time numeric code emailed to a teacher or student to confirm they
// own the email address on their account. Only TEACHER and STUDENT roles
// use this today.
model EmailVerificationCode {
  id        String    @id @default(uuid())
  codeHash  String
  role      Role
  userId    String
  email     String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([role, userId])
  @@index([expiresAt])
}

model Guardian {
  id        String   @id @default(uuid())
  fullName  String   @unique
  email     String   @unique
  phone     String
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students GuardianStudent[]
}

model GuardianStudent {
  id         String   @id @default(uuid())
  guardianId String
  studentId  String
  relation   String
  createdAt  DateTime @default(now())

  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([guardianId, studentId])
  @@index([studentId])
  @@index([guardianId])
}

model Class {
  id                   String                @id @default(uuid())
  name                 String
  description          String?
  teacherId            String
  createdAt            DateTime              @default(now())
  startDate            DateTime?
  status               Int                   @default(0)
  schedule             String                @default("TBD")
  monthlyFee           Int                   @default(0)
  paymentDueWeek       Int                   @default(1)
  teacher              Teacher               @relation(fields: [teacherId], references: [id])
  payments             ClassPayment[]
  feeHistory           ClassFee[]
  schedules            ClassSchedule[]
  sessions             ClassSession[]
  students             ClassStudent[]
  studentHistory       ClassStudentHistory[]
  lectures             Lecture[]
  materialBundles      MaterialBundle[]
  messages             Message[]
  paperSupportMessages PaperSupportMessage[]
  classPapers          ClassPaper[]

  publicRegistrations Student[] @relation("PublicClassRegistration")

  @@index([teacherId, createdAt])
}

model ClassFee {
  id      String @id @default(uuid())
  classId String

  amount Int

  effectiveFrom DateTime
  effectiveTo   DateTime?

  createdAt DateTime @default(now())

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId, effectiveFrom])
}

model TeacherPaperConfig {
  id                     String   @id @default(uuid())
  teacherId              String   @unique
  countdownLeadMinutes   Int      @default(30)
  submissionGraceMinutes Int      @default(20)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  teacher                Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model ClassPaper {
  id      String @id @default(uuid())
  classId String

  name        String
  description String?

  // The paper file the teacher uploads (PDF or image).
  pdfName     String
  pdfUrl      String
  pdfMimeType String

  maxMarks Decimal?

  startTime DateTime
  endTime   DateTime

  sortOrder Int @default(0)

  // 0 = active, 1 = removed (soft-deleted). Only status 0 is shown anywhere.
  status Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  submissions ClassPaperStudent[]

  @@index([classId, status])
  @@index([startTime, endTime])
}

model ClassPaperStudent {
  id String @id @default(uuid())

  classPaperId String
  studentId    String

  submitted   Boolean   @default(false)
  submittedAt DateTime?

  // The student's answer file (PDF or image), stored under /storage.
  submissionPdfUrl   String?
  submissionFileName String?
  submissionMimeType String?

  marks    Decimal?
  markedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classPaper ClassPaper @relation(fields: [classPaperId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classPaperId, studentId])
  @@index([studentId])
  @@index([classPaperId])
}

model MaterialBundle {
  id                   String                    @id @default(uuid())
  classId              String
  year                 Int
  month                Int
  bundleStatus         BundleStatus              @default(DRAFT)
  // 0 = active, 1 = removed (soft-deleted). Only status 0 is shown anywhere.
  status               Int                       @default(0)
  sentAt               DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  title                String
  class                Class                     @relation(fields: [classId], references: [id], onDelete: Cascade)
  items                MaterialBundleItem[]
  recipients           MaterialBundleRecipient[]
  paperSupportMessages PaperSupportMessage[]

  @@index([classId, year, month])
  @@index([bundleStatus, sentAt])
  @@index([classId, status])
}

model MaterialBundleItem {
  id                   String                         @id @default(uuid())
  bundleId             String
  type                 MaterialBundleItemType
  title                String
  description          String?
  fileName             String?
  fileUrl              String?
  mimeType             String?
  sizeBytes            Int?
  paperStartAt         DateTime?
  paperEndAt           DateTime?
  // 0 = active, 1 = removed (soft-deleted). Only status 0 is shown anywhere.
  status               Int                            @default(0)
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt
  bundle               MaterialBundle                 @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  submissions          MaterialBundleItemSubmission[]
  paperSupportMessages PaperSupportMessage[]

  @@index([bundleId, type, createdAt])
  @@index([bundleId, status])
}

model PaperSupportMessage {
  id        String             @id @default(uuid())
  bundleId  String
  itemId    String
  classId   String
  teacherId String
  studentId String
  message   String
  createdAt DateTime           @default(now())
  bundle    MaterialBundle     @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  class     Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  item      MaterialBundleItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  student   Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher   Teacher            @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt])
  @@index([studentId, createdAt])
  @@index([teacherId, createdAt])
  @@index([classId, createdAt])
}

model MaterialBundleItemSubmission {
  id          String   @id @default(uuid())
  itemId      String
  studentId   String
  fileName    String
  fileUrl     String
  mimeType    String
  sizeBytes   Int
  submittedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  // Teacher review — reviewedAt null means the submission hasn't been
  // reviewed/marked yet.
  marks      Int?
  reviewedAt DateTime?

  item    MaterialBundleItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  student Student            @relation(fields: [studentId], references: [id])

  @@index([itemId, studentId, submittedAt])
  @@index([studentId, submittedAt])
}

model MaterialBundleRecipient {
  id          String         @id @default(uuid())
  bundleId    String
  studentId   String
  willReceive Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  receivedAt  DateTime?
  bundle      MaterialBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  student     Student        @relation(fields: [studentId], references: [id])

  @@unique([bundleId, studentId])
  @@index([studentId, willReceive])
}

model ClassSchedule {
  id        String   @id @default(uuid())
  classId   String
  dayOfWeek Weekday
  startTime String
  endTime   String
  createdAt DateTime @default(now())
  class     Class    @relation(fields: [classId], references: [id])

  @@index([classId, dayOfWeek])
}

model ClassSession {
  id                            String                  @id @default(uuid())
  classId                       String
  roomName                      String                  @unique
  jitsiDomain                   String                  @default("meet.jit.si")
  startedAt                     DateTime                @default(now())
  endedAt                       DateTime?
  isActive                      Boolean                 @default(true)
  createdAt                     DateTime                @default(now())
  lectureId                     String?
  /// Last time the class's own teacher had this classroom open: set when the
  /// teacher's live-updates SSE connection opens and refreshed while it stays
  /// open (lib/teacher-presence.ts). Null until then and for older sessions.
  /// Never used on its own to decide that the teacher left.
  teacherLastSeenAt             DateTime?
  /// The teacher's current classroom page instance (lib/teacher-presence.ts):
  /// registered by each page when it loads (the newest load), handed over to
  /// a live page whose activity followed the current page's tab-close
  /// signal. Only this page can send a tab-close signal. Null: none yet.
  teacherCurrentPageId          String?
  /// Teacher tab-close signal (lib/teacher-presence.ts): when the current
  /// classroom page reported it was closing (pagehide, not persisted; desktop
  /// browsers only), and which page sent it. Null: no signal.
  teacherDepartureAt            DateTime?
  teacherDeparturePageId        String?
  /// First activity of a live teacher page after that signal (a new page,
  /// another tab's heartbeat, a resume). Within the reload-confirmation
  /// window it cancels the signal; later it is the teacher's return.
  teacherActiveAfterDepartureAt DateTime?
  /// Backend Jibri stop after a confirmed teacher departure
  /// (lib/jibri-stop-for-departure.ts). jibriStopDepartureAt: the
  /// teacherDepartureAt this state belongs to (a later departure starts
  /// afresh). jibriStopState: provisional | pending | stop-sent |
  /// verifying | unresolved (open), confirmed | not-running (released; an
  /// override also releases). The attempt is recorded (attemptedAt,
  /// attemptCount) BEFORE connecting to Jitsi.
  /// jibriStopLastError: an outcome code only (never a token or a name).
  /// jibriStopConfirmedAt: when the fence was released by evidence: the
  /// room clear AND three idle readings of the pinned stream, at least 30 s
  /// apart, over at least 2 minutes.
  jibriStopDepartureAt          DateTime?
  jibriStopState                String?
  jibriStopAttemptedAt          DateTime?
  jibriStopAttemptCount         Int                     @default(0)
  jibriStopLastError            String?
  jibriStopConfirmedAt          DateTime?
  /// When the backend sent the Jibri STOP for this fence, written BEFORE
  /// sending; never a second STOP for the same fence (observation only).
  jibriStopSentAt               DateTime?
  /// Shutdown fence evidence (lib/jibri-shutdown-gate.ts): when the stream
  /// recorder was seen leaving the room voluntarily after our STOP, and the
  /// first of the three "no ingest" readings of the pinned YouTube stream
  /// that a release needs (reset by any other reading).
  jibriStopRecorderLeftAt       DateTime?
  jibriStopStreamInactiveAt     DateTime?
  /// An administrator's explicit release of the fence (never automatic):
  /// who, when, why. Every override is also kept in JibriShutdownOverride.
  jibriStopOverrideAt           DateTime?
  jibriStopOverrideBy           String?
  jibriStopOverrideReason       String?
  jibriShutdownOverrides        JibriShutdownOverride[]
  /// The teacher's reusable YouTube stream the classroom's Jibri pushed
  /// into, pinned when the fence was created (the tab-close signal's
  /// provisional fence; else when armed). Only THIS stream is ever checked;
  /// a newer or reconnected stream never stands in for it.
  jibriStopStreamId             String?
  /// The series of "no ingest" readings (the first is
  /// jibriStopStreamInactiveAt): how many so far and the latest. Reset by
  /// any other reading.
  jibriStopIdleReadingCount     Int                     @default(0)
  jibriStopLastIdleAt           DateTime?
  /// After a release: the stream is still watched until then; it resuming
  /// (with no new feature of the teacher) re-opens the fence.
  jibriStopWatchUntil           DateTime?
  /// Who armed the fence: signal (the tab-close signal's provisional
  /// fence), departure (the YouTube departure stop), worker, late (found
  /// after the session ended without a fence) or start (a start found it).
  jibriStopOrigin               String?
  attendance                    Attendance[]
  class                         Class                   @relation(fields: [classId], references: [id])
  lecture                       Lecture?                @relation(fields: [lectureId], references: [id])

  @@index([classId, isActive])
  @@index([classId, isActive, startedAt])
  @@index([lectureId, startedAt])
  /// Open shutdown fences of a class (lib/jibri-shutdown-gate.ts).
  @@index([classId, jibriStopState])
  /// Recently ended sessions with a departure (late-fence recovery).
  @@index([isActive, endedAt])
}

/// The ONE shared source of the Jibri shutdown fence's mode and the
/// worker's heartbeat (lib/jibri-fence-control.ts): the app and the worker
/// both read it. Single row (id "default"); no row: mode "off".
model JibriShutdownControl {
  id                    String    @id
  /// off: nothing armed, no worker work (open fences stay enforced).
  /// on: armed at departure, STOP + verification by the worker.
  /// drain: nothing new armed, no STOP; the worker only verifies open fences.
  mode                  String    @default("off")
  modeChangedAt         DateTime?
  modeChangedBy         String?
  /// The worker's liveness: written on its own timer, independent of sweeps
  /// and of any Jitsi connection.
  heartbeatAt           DateTime?
  workerStartedAt       DateTime?
  workerVersion         String?
  /// A hash of the worker's non-secret Jitsi settings (domains, focus JID, URL).
  workerConfigId        String?
  /// The mode the worker saw at its last tick.
  workerMode            String?
  /// The worker's Jitsi target and JWT identity (non-secret; the secret
  /// only as a non-reversible fingerprint), compared field by field with
  /// what the app expects (lib/jibri-stop-config.ts).
  workerJitsiDomain     String?
  workerWebsocketUrl    String?
  workerMucDomain       String?
  workerRecorderDomain  String?
  workerFocusJid        String?
  workerJwtIssuer       String?
  workerJwtAudience     String?
  workerJwtFingerprint  String?
  /// Sweep progress, separate from liveness (heartbeatAt): the last sweep
  /// that began and the last one that completed.
  sweepStartedAt        DateTime?
  sweepCompletedAt      DateTime?
  /// Connection proof (not the heartbeat): the last XMPP login to the
  /// expected server, the last join of an expected room as a moderator,
  /// and the last connection failure (an outcome code) and when.
  lastXmppAuthAt        DateTime?
  lastRoomJoinAt        DateTime?
  lastConnectionError   String?
  lastConnectionErrorAt DateTime?
  updatedAt             DateTime  @updatedAt
}

/// Audit log of fence mode changes by administrators (append-only).
model JibriShutdownModeChange {
  id         String   @id @default(uuid())
  fromMode   String
  toMode     String
  adminId    String
  adminEmail String?
  reason     String
