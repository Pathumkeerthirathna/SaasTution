  @@index([createdAt])
}

/// Audit log of administrators' Jibri shutdown fence overrides
/// (services/jibri-fence-override-service.ts): append-only, one row per
/// override, never written automatically.
model JibriShutdownOverride {
  id               String       @id @default(uuid())
  classSessionId   String
  /// The fence (ClassSession.jibriStopDepartureAt) this override released.
  fenceDepartureAt DateTime
  /// The fence's state when it was overridden (pending, stop-sent, ...).
  previousState    String?
  adminId          String
  adminEmail       String?
  reason           String
  createdAt        DateTime     @default(now())
  classSession     ClassSession @relation(fields: [classSessionId], references: [id])

  @@index([classSessionId, createdAt])
}

