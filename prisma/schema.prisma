generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Teacher {
  id                     String                @id @default(uuid())
  name                   String
  email                  String                @unique
  password               String
  createdAt              DateTime              @default(now())
  classes                Class[]
  confirmedClassPayments ClassPayment[]        @relation("ClassPaymentConfirmedBy")
  paperSupportMessages   PaperSupportMessage[]
  paymentMessages        PaymentMessage[]
  paperConfig            TeacherPaperConfig?

  @@index([createdAt])
}

model Student {
  id                            String                         @id @default(uuid())
  name                          String
  createdAt                     DateTime                       @default(now())
  contact                       String
  registrationNumber            String?                        @unique
  grade                         GradeLevel?
  contact01                     String?
  contact02                     String?
  email                         String?
  password                      String?
  submissions                   AssignmentSubmission[]
  attendance                    Attendance[]
  classPayments                 ClassPayment[]
  classes                       ClassStudent[]
  guardians                     Guardian[]
  materialBundleItemSubmissions MaterialBundleItemSubmission[]
  materialBundleRecipients      MaterialBundleRecipient[]
  deliveries                    MessageDelivery[]
  paperSupportMessages          PaperSupportMessage[]
  paymentMessages               PaymentMessage[]
  quizSubmissions               QuizSubmission[]
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  role      Role
  userId    String
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([role, userId])
  @@index([expiresAt])
}

model Guardian {
  id        String   @id @default(uuid())
  name      String
  relation  String
  phone     String
  studentId String
  email     String?  @unique
  password  String?
  createdAt DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id])

  @@index([studentId])
}

model Class {
  id                   String                @id @default(uuid())
  name                 String
  description          String?
  teacherId            String
  createdAt            DateTime              @default(now())
  schedule             String                @default("TBD")
  monthlyFee           Int                   @default(0)
  paymentDueWeek       Int                   @default(1)
  teacher              Teacher               @relation(fields: [teacherId], references: [id])
  payments             ClassPayment[]
  schedules            ClassSchedule[]
  sessions             ClassSession[]
  students             ClassStudent[]
  lectures             Lecture[]
  materialBundles      MaterialBundle[]
  messages             Message[]
  paperSupportMessages PaperSupportMessage[]

  @@index([teacherId, createdAt])
}

model TeacherPaperConfig {
  id                     String   @id @default(uuid())
  teacherId              String   @unique
  countdownLeadMinutes   Int      @default(30)
  submissionGraceMinutes Int      @default(20)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  teacher                Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model MaterialBundle {
  id                   String                    @id @default(uuid())
  classId              String
  year                 Int
  month                Int
  status               MaterialBundleStatus      @default(DRAFT)
  sentAt               DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  title                String
  class                Class                     @relation(fields: [classId], references: [id], onDelete: Cascade)
  items                MaterialBundleItem[]
  recipients           MaterialBundleRecipient[]
  paperSupportMessages PaperSupportMessage[]

  @@index([classId, year, month])
  @@index([status, sentAt])
}

model MaterialBundleItem {
  id                   String                         @id @default(uuid())
  bundleId             String
  type                 MaterialBundleItemType
  title                String
  description          String?
  fileName             String?
  fileUrl              String?
  mimeType             String?
  sizeBytes            Int?
  paperStartAt         DateTime?
  paperEndAt           DateTime?
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt
  bundle               MaterialBundle                 @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  submissions          MaterialBundleItemSubmission[]
  paperSupportMessages PaperSupportMessage[]

  @@index([bundleId, type, createdAt])
}

model PaperSupportMessage {
  id        String             @id @default(uuid())
  bundleId  String
  itemId    String
  classId   String
  teacherId String
  studentId String
  message   String
  createdAt DateTime           @default(now())
  bundle    MaterialBundle     @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  class     Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  item      MaterialBundleItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  student   Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher   Teacher            @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt])
  @@index([studentId, createdAt])
  @@index([teacherId, createdAt])
  @@index([classId, createdAt])
}

model MaterialBundleItemSubmission {
  id          String             @id @default(uuid())
  itemId      String
  studentId   String
  fileName    String
  fileUrl     String
  mimeType    String
  sizeBytes   Int
  submittedAt DateTime           @default(now())
  createdAt   DateTime           @default(now())
  item        MaterialBundleItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  student     Student            @relation(fields: [studentId], references: [id])

  @@index([itemId, studentId, submittedAt])
  @@index([studentId, submittedAt])
}

model MaterialBundleRecipient {
  id          String         @id @default(uuid())
  bundleId    String
  studentId   String
  willReceive Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  receivedAt  DateTime?
  bundle      MaterialBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  student     Student        @relation(fields: [studentId], references: [id])

  @@unique([bundleId, studentId])
  @@index([studentId, willReceive])
}

model ClassSchedule {
  id        String   @id @default(uuid())
  classId   String
  dayOfWeek Weekday
  startTime String
  endTime   String
  createdAt DateTime @default(now())
  class     Class    @relation(fields: [classId], references: [id])

  @@index([classId, dayOfWeek])
}

model ClassSession {
  id          String       @id @default(uuid())
  classId     String
  roomName    String       @unique
  jitsiDomain String       @default("meet.jit.si")
  startedAt   DateTime     @default(now())
  endedAt     DateTime?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  lectureId   String?
  attendance  Attendance[]
  class       Class        @relation(fields: [classId], references: [id])
  lecture     Lecture?     @relation(fields: [lectureId], references: [id])

  @@index([classId, isActive])
  @@index([classId, isActive, startedAt])
  @@index([lectureId, startedAt])
}

model ClassStudent {
  id           String    @id @default(uuid())
  classId      String
  studentId    String
  isActive     Boolean   @default(true)
  assignedAt   DateTime  @default(now())
  removedAt    DateTime?
  removeReason String?
  class        Class     @relation(fields: [classId], references: [id])
  student      Student   @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@index([classId, isActive])
}

model Lecture {
  id          String         @id @default(uuid())
  title       String
  date        DateTime
  classId     String
  createdAt   DateTime       @default(now())
  assignments Assignment[]
  sessions    ClassSession[]
  class       Class          @relation(fields: [classId], references: [id])
  notes       Note[]
  quizzes     Quiz[]

  @@index([classId, date])
}

model Note {
  id               String    @id @default(uuid())
  title            String
  fileUrl          String
  lectureId        String
  kind             NoteKind  @default(NOTE)
  mimeType         String
  sizeBytes        Int
  downloadCount    Int       @default(0)
  lastDownloadedAt DateTime?
  lecture          Lecture   @relation(fields: [lectureId], references: [id])

  @@index([lectureId])
}

model Assignment {
  id          String                 @id @default(uuid())
  title       String
  description String
  dueDate     DateTime
  lectureId   String
  lecture     Lecture                @relation(fields: [lectureId], references: [id])
  submissions AssignmentSubmission[]

  @@index([lectureId, dueDate])
}

model AssignmentSubmission {
  id           String     @id @default(uuid())
  assignmentId String
  studentId    String
  notes        String?
  submittedAt  DateTime   @default(now())
  fileName     String
  fileUrl      String
  mimeType     String
  sizeBytes    Int
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      Student    @relation(fields: [studentId], references: [id])

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@index([assignmentId])
}

model Quiz {
  id          String           @id @default(uuid())
  title       String
  lectureId   String
  dueDate     DateTime?
  maxAttempts Int?
  lecture     Lecture          @relation(fields: [lectureId], references: [id])
  questions   QuizQuestion[]
  submissions QuizSubmission[]

  @@index([lectureId])
}

model QuizQuestion {
  id                String                 @id @default(uuid())
  quizId            String
  text              String
  orderIndex        Int
  answerType        QuizAnswerType
  quiz              Quiz                   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options           QuizQuestionOption[]
  submissionAnswers QuizSubmissionAnswer[]

  @@index([quizId, orderIndex])
}

model QuizQuestionOption {
  id         String       @id @default(uuid())
  questionId String
  text       String
  isCorrect  Boolean      @default(false)
  orderIndex Int
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, orderIndex])
}

model QuizSubmission {
  id             String                 @id @default(uuid())
  quizId         String
  studentId      String
  score          Int
  totalQuestions Int
  submittedAt    DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  attemptCount   Int                    @default(1)
  quiz           Quiz                   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student        Student                @relation(fields: [studentId], references: [id])
  answers        QuizSubmissionAnswer[]

  @@unique([quizId, studentId])
  @@index([studentId])
  @@index([quizId])
}

model QuizSubmissionAnswer {
  id                String         @id @default(uuid())
  submissionId      String
  questionId        String
  selectedOptionIds String[]
  isCorrect         Boolean
  question          QuizQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  submission        QuizSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, questionId])
  @@index([questionId])
}

model Attendance {
  id             String       @id @default(uuid())
  studentId      String
  classId        String
  joinedAt       DateTime     @default(now())
  classSessionId String
  leftAt         DateTime?
  classSession   ClassSession @relation(fields: [classSessionId], references: [id])
  student        Student      @relation(fields: [studentId], references: [id])

  @@index([classId])
  @@index([classId, joinedAt])
  @@index([classSessionId])
  @@index([classSessionId, joinedAt])
  @@index([classSessionId, studentId, joinedAt])
}

model Message {
  id         String            @id @default(uuid())
  content    String
  classId    String
  createdAt  DateTime          @default(now())
  class      Class             @relation(fields: [classId], references: [id])
  deliveries MessageDelivery[]

  @@index([classId, createdAt])
}

model MessageDelivery {
  id                String                @id @default(uuid())
  messageId         String
  studentId         String
  status            MessageDeliveryStatus @default(QUEUED)
  provider          String?
  providerMessageId String?
  error             String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  message           Message               @relation(fields: [messageId], references: [id])
  student           Student               @relation(fields: [studentId], references: [id])

  @@unique([messageId, studentId])
  @@index([messageId, createdAt])
  @@index([messageId, status])
  @@index([providerMessageId])
}

model ClassPayment {
  id                   String             @id @default(uuid())
  classId              String
  studentId            String
  month                String
  amount               Int
  note                 String?
  slipFileName         String?
  slipFileUrl          String?
  slipMimeType         String?
  slipSizeBytes        Int?
  status               ClassPaymentStatus @default(PENDING)
  teacherFeedback      String?
  submittedAt          DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  confirmedAt          DateTime?
  confirmedByTeacherId String?
  class                Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  confirmedByTeacher   Teacher?           @relation("ClassPaymentConfirmedBy", fields: [confirmedByTeacherId], references: [id])
  student              Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  messages             PaymentMessage[]

  @@unique([classId, studentId, month])
  @@index([studentId, month])
  @@index([classId, month, status])
}

model PaymentMessage {
  id             String               @id @default(uuid())
  paymentId      String
  senderRole     PaymentMessageSender
  studentId      String?
  teacherId      String?
  message        String
  proofFileName  String?
  proofFileUrl   String?
  proofMimeType  String?
  proofSizeBytes Int?
  createdAt      DateTime             @default(now())
  payment        ClassPayment         @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  student        Student?             @relation(fields: [studentId], references: [id])
  teacher        Teacher?             @relation(fields: [teacherId], references: [id])

  @@index([paymentId, createdAt])
}

enum Role {
  TEACHER
  STUDENT
  GUARDIAN
  ADMIN
}

enum MessageDeliveryStatus {
  QUEUED
  SENT
  FAILED
}

enum NoteKind {
  NOTE
  SUPPORTING_MATERIAL
}

enum Weekday {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum GradeLevel {
  GRADE_01
  GRADE_02
  GRADE_03
  GRADE_04
  GRADE_05
  GRADE_06
  GRADE_07
  GRADE_08
  GRADE_09
  GRADE_10
  GRADE_11
  GRADE_12
  GRADE_13
}

enum QuizAnswerType {
  SINGLE
  MULTIPLE
}

enum MaterialBundleStatus {
  DRAFT
  SENT
}

enum MaterialBundleItemType {
  TUTE
  PAPER
}

enum ClassPaymentStatus {
  PENDING
  CONFIRMED
  NEEDS_CLARIFICATION
}

enum PaymentMessageSender {
  STUDENT
  TEACHER
}
