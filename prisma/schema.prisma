  @@index([classSessionId, createdAt])
  @@index([publishGroupId])
}

model BreakoutAssignmentDraft {
  id             String   @id @default(uuid())
  assignmentId   String
  classSessionId String
  studentId      String
  answerText     String   @default("")
  revision       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assignment   BreakoutAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  classSession ClassSession       @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  student      Student            @relation(fields: [studentId], references: [id])

  @@unique([assignmentId, studentId])
  @@index([classSessionId])
}

model BreakoutAssignmentSubmission {
  id             String   @id @default(uuid())
  assignmentId   String
  classSessionId String
  studentId      String
  version        Int
  /// At most one true per (assignment, student): enforced by the partial
  /// unique index "BreakoutAssignmentSubmission_one_latest_key" (migration SQL;
  /// Prisma 5.22 cannot declare partial indexes). See
  /// docs/breakout-activities-migrations.md before editing any migration.
  isLatest       Boolean  @default(true)
  answerText     String?
  fileName       String?  @db.VarChar(200)
  filePath       String?
  fileSize       Int?
  idempotencyKey String   @db.VarChar(64)
  submittedAt    DateTime @default(now())

  assignment   BreakoutAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  classSession ClassSession       @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  student      Student            @relation(fields: [studentId], references: [id])

  @@unique([assignmentId, studentId, version])
  @@unique([assignmentId, studentId, idempotencyKey])
  @@index([assignmentId, isLatest])
  @@index([classSessionId])
}

model BreakoutQuiz {
