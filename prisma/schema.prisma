// ---------------------------------------------------------------------------
// Breakout Group Activities. A group is the students the teacher confirmed
// for one breakout room of a session (BreakoutRoomMember); a GROUP-mode
// assignment / quiz row targets exactly one room, so it has exactly one
// group, one shared work / attempt and one final submission. Access to group
// work is decided by confirmed membership only (never by live Jitsi state).
// ---------------------------------------------------------------------------

/// Teacher-confirmed membership of one breakout room (Group Activities
/// authorization only; never used by the existing breakout-room features).
/// status 0 = active, 1 = removed (soft delete). At most one ACTIVE row per
/// (classSessionId, studentId): enforced by the partial unique index
/// "BreakoutRoomMember_one_active_key" (migration SQL; Prisma 5.22 cannot
/// declare partial indexes). See docs/breakout-activities-migrations.md.
model BreakoutRoomMember {
  id                   String    @id @default(uuid())
  classSessionId       String
  /// The Jitsi breakout room id, as the teacher's classroom page lists it.
  roomId               String    @db.VarChar(255)
  roomName             String    @db.VarChar(120)
  studentId            String
  confirmedByTeacherId String
  confirmedAt          DateTime
  removedAt            DateTime?
  status               Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  classSession ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id])

  @@index([classSessionId, roomId, status])
  @@index([classSessionId, studentId])
}

/// The shared workspace of one GROUP-mode assignment, and its single final
/// submission (submittedAt set = final; no versions).
model BreakoutGroupAssignmentWork {
  id                    String    @id @default(uuid())
  assignmentId          String    @unique
  classSessionId        String
  answerText            String    @default("")
  revision              Int       @default(0)
  lastEditedByStudentId String?
  lastEditedAt          DateTime?
  submittedAt           DateTime?
  submittedByStudentId  String?
  /// Student ids of the confirmed members at submission time.
  memberStudentIds      Json?
  fileName              String?   @db.VarChar(200)
  filePath              String?
  fileSize              Int?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  assignment   BreakoutAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  classSession ClassSession       @relation(fields: [classSessionId], references: [id], onDelete: Cascade)

  @@index([classSessionId])
}

/// The shared attempt of one GROUP-mode quiz (answers in the same shape as
/// BreakoutQuizSubmission, graded by the same marking.mjs).
model BreakoutGroupQuizAttempt {
  id                   String                    @id @default(uuid())
  quizId               String                    @unique
  classSessionId       String
  attemptStatus        BreakoutQuizAttemptStatus @default(IN_PROGRESS)
  answers              Json                      @default("{}")
  revision             Int                       @default(0)
  startedAt            DateTime                  @default(now())
  startedByStudentId   String
  deadlineAt           DateTime?
  lastSavedAt          DateTime?
  lastSavedByStudentId String?
  submittedAt          DateTime?
  submittedByStudentId String?
  /// Student ids of the confirmed members at submission time.
  memberStudentIds     Json?
  /// BreakoutQuizGrading (lib/breakout-activities/marking.mjs).
  grading              Json?
  autoScore            Decimal?                  @db.Decimal(7, 2)
  finalScore           Decimal?                  @db.Decimal(7, 2)
  overriddenAt         DateTime?
  updatedAt            DateTime                  @updatedAt

  quiz         BreakoutQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  classSession ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)

  @@index([classSessionId])
}

// ---------------------------------------------------------------------------
// Recorded Lectures (RL-2): uploaded MP4 recording parts of a lecture.
//
// Migration 20261114120000_add_recorded_lectures holds hand-written CHECK
// constraints and one partial unique index that Prisma 5.22 cannot express
// (guarded by tests/recorded-lectures/recorded-lectures-migration-guard.test.cjs).
// Apply with `prisma migrate deploy` only, never `prisma db push`.
//
// Timestamps have no database default: the application writes real UTC
// instants (serverNow()), and every lease / expiry comparison uses the same
// application clock, never the database's now().
//
// BigInt columns arrive in JavaScript as `bigint`. Code using them (RL-3)
// must convert with Number() only after Number.isSafeInteger() holds,
// failing closed otherwise, and must never put a raw bigint into JSON
// (JSON.stringify throws on it).
//
// Prisma enums only limit the values. The transitions below are NOT enforced
// by the database: RL-3 enforces them with conditional updates
// (WHERE "state" = <expected>) inside transactions.
// ---------------------------------------------------------------------------

/// Lifecycle of a recording part:
///   UPLOADING -> VERIFYING -> READY
///   UPLOADING -> FAILED
///   VERIFYING -> FAILED
/// READY and FAILED are final. Only READY parts (status 0) can be played by
/// students.
enum RecordedLectureState {
  UPLOADING
  VERIFYING
  READY
  FAILED
}

/// Lifecycle of an upload session:
///   ACTIVE -> COMPLETING -> COMPLETED
///   ACTIVE | COMPLETING -> FAILED | EXPIRED | CANCELLED
/// COMPLETED, FAILED, EXPIRED and CANCELLED are final.
enum RecordingUploadState {
  ACTIVE
  COMPLETING
  COMPLETED
  FAILED
  EXPIRED
  CANCELLED
}

/// One uploaded recording part of a lecture, created when its upload starts
/// (state UPLOADING). The stored file is
///   Teachers/{teacherId}/Lectures/{lectureId}/RecordedLectures/{id}/{storedFileName}
/// below FILE_STORAGE_ROOT, so id, teacherId and lectureId never change
/// (their foreign keys are ON UPDATE RESTRICT).
///
/// Ownership: teacherId is the teacher who owns the lecture's class, enforced
/// by the composite foreign key (classId, teacherId) -> Class(id, teacherId);
/// (lectureId, classId) -> Lecture(id, classId) ties the lecture to that
/// same class.
///
/// status:
///   0 = active recording.
///   2 = purge pending: deletion was requested and the stored file's
///       deletion is pending or failed; the cleanup can be retried.
///   1 = removed: the stored file's deletion has completed (final).
/// Lifecycle:
///   1. status 0: deletedAt, purgeRequestedAt and purgedAt are NULL.
///   2. Deletion requested: status 2, deletedAt and purgeRequestedAt set,
///      purgedAt NULL; playback is unavailable from then on.
///   3. File deletion succeeded: status 1, purgeRequestedAt cleared,
///      purgedAt set (deletedAt kept).
///   4. File deletion failed: stays status 2, so the cleanup is retried.
/// Status 1 is not recoverable; retryable cleanup is status 2. Only status 0
/// is shown anywhere (CHECKs enforce the column / status pairing).
/// Part numbers are unique per lecture among status-0 parts that are not
/// FAILED (hand-written partial unique index
/// "RecordedLecture_active_part_number_key").
model RecordedLecture {
  id        String @id @default(uuid())
  lectureId String
  classId   String
  teacherId String

  /// 1..200 characters (VarChar + CHECK).
  title           String @db.VarChar(200)
  partNumber      Int
  /// For display only; never part of a storage key. Ends in ".mp4".
  displayFileName String @db.VarChar(200)
  /// Always "video/mp4" (CHECK).
  mimeType        String @db.VarChar(32)
  /// Declared size in bytes: 1..64,000,000,000 (CHECK; the highest allowed
  /// RECORDED_LECTURE_MAX_PART_BYTES).
  sizeBytes       BigInt

  /// "{32 lowercase hex}.mp4" (CHECK). Null until the file is moved to its
  /// final place; required when READY.
  storedFileName  String?  @db.VarChar(36)
  /// Whole seconds, 1..172,800 (48 hours, CHECK); required when READY. An
  /// invalid or longer duration fails the upload (RL-3); it is never stored
  /// as NULL instead.
  durationSeconds Int?
  /// 1..65,535 (CHECK); NULL when the file does not state it.
  width           Int?
  height          Int?
  /// e.g. "avc1.64001F" (CHECK); required when READY.
  videoCodec      String?  @db.VarChar(32)
  /// "mp4a.40.2" | "mp4a.40.5" | "mp4a.40.29" (CHECK); required when READY.
  audioCodec      String?  @db.VarChar(32)
  /// Required when READY.
  fragmented      Boolean?

  state       RecordedLectureState
  /// UPPER_SNAKE code; set exactly when FAILED (CHECK).
  failureCode String?              @db.VarChar(64)

  /// Public class pages only (migration 20261124120000_add_recorded_lecture_publication):
  /// PUBLIC lists the recording on its class's public page while the
  /// teacher's public profile is enabled; access FREE ("Unlocked") also lets
  /// anyone play it there, LOCKED shows it behind a lock. Every new and every
  /// existing recording is PRIVATE + LOCKED (database defaults; the upload
  /// never sets them). Enrolled students are NOT limited by these: the
  /// student access filter does not read them.
  visibility RecordingVisibility @default(PRIVATE)
  access     RecordingAccess     @default(LOCKED)

  status             Int       @default(0)
  /// When deletion was requested; set exactly when status <> 0 (CHECK).
  deletedAt          DateTime?
  /// Who requested the deletion (NULL: the system). Only with deletedAt.
  deletedByTeacherId String?
  /// Set exactly when status = 2 (CHECK).
  purgeRequestedAt   DateTime?
  /// When the stored recording file's physical deletion completed; set
  /// exactly when status = 1 (CHECK), NULL while active or purge pending.
  purgedAt           DateTime? @db.Timestamp(3)

  createdAt DateTime
  updatedAt DateTime
  /// Set exactly when READY / FAILED (CHECK).
  readyAt   DateTime?
  failedAt  DateTime?

  lecture   Lecture  @relation(fields: [lectureId, classId], references: [id, classId], onDelete: Cascade, onUpdate: Restrict)
  class     Class    @relation(fields: [classId, teacherId], references: [id, teacherId], onDelete: Restrict, onUpdate: Restrict)
  teacher   Teacher  @relation("RecordedLectureTeacher", fields: [teacherId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  deletedBy Teacher? @relation("RecordedLectureDeletedBy", fields: [deletedByTeacherId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  uploadSession RecordingUploadSession?

  /// Target of RecordingUploadSession's composite (recordedLectureId,
  /// teacherId) foreign key, so the session's teacher always equals the
  /// recording's.
  @@unique([id, teacherId])
  @@index([lectureId, status, state, partNumber])
  @@index([teacherId, createdAt])
  @@index([classId])
}

/// The upload of one RecordedLecture (exactly one per recording). The bytes
/// are assembled in System/TemporaryUploads/{id}.part; the in-flight chunk
/// is System/TemporaryUploads/{id}.{leaseToken}.chunk.
///
/// receivedBytes is the source of truth: the .part file may hold more bytes
/// after a crash and is truncated to receivedBytes before the next append.
///
/// Chunk lease (at most one chunk in flight per upload): the five lease
/// columns are all NULL or all set; a lease starts at receivedBytes, fits in
/// the bytes remaining and exists only while ACTIVE (CHECKs). Chunk ORDER is
/// enforced by RL-3's conditional update (no trigger): the chunk row is
/// inserted and receivedBytes advanced in one transaction, only WHERE the
/// lease token, offset and expiry still match.
model RecordingUploadSession {
  id                String @id @default(uuid())
  /// One session per recording: the composite unique (recordedLectureId,
  /// teacherId) below is enough, since a recording has exactly one
  /// teacherId (RecordedLecture.id is its primary key).
  recordedLectureId String
  /// Always the recording's teacherId (composite foreign key).
  teacherId         String

  /// 1..64,000,000,000 (CHECK).
  expectedBytes BigInt
  /// 0..expectedBytes (CHECK).
  receivedBytes BigInt @default(0)
  /// Committed chunks; 0 exactly when receivedBytes is 0 (CHECK).
  chunkCount    Int    @default(0)

  state       RecordingUploadState
  /// UPPER_SNAKE code; set exactly when FAILED (CHECK).
  failureCode String?              @db.VarChar(64)

  /// 64 lowercase hex characters, never reused (unique, also among chunks).
  leaseToken     String?   @unique @db.Char(64)
  /// Always equal to receivedBytes while a lease exists (CHECK).
  leaseOffset    BigInt?
  /// 1..67,108,864 and at most expectedBytes - receivedBytes (CHECK).
  leaseBytes     Int?
  leaseGrantedAt DateTime?
  /// After leaseGrantedAt (CHECK).
  leaseExpiresAt DateTime?

  /// When an unfinished upload expires (createdAt + upload expiry).
  expiresAt      DateTime
  lastActivityAt DateTime
  createdAt      DateTime
  updatedAt      DateTime
  /// Set exactly when the state is final (CHECK).
  endedAt        DateTime?

  /// Optimistic concurrency: incremented by every RL-3 update.
  version Int @default(0)

  recordedLecture RecordedLecture        @relation(fields: [recordedLectureId, teacherId], references: [id, teacherId], onDelete: Cascade, onUpdate: Restrict)
  chunks          RecordingUploadChunk[]

  @@unique([recordedLectureId, teacherId])
  @@index([teacherId, state])
  @@index([state, expiresAt])
  @@index([state])
}

/// Append-only record of the chunks accepted for an upload. Duplicates are
/// impossible: one row per (session, chunkIndex), per (session, startOffset)
/// and per lease token.
model RecordingUploadChunk {
  id              String   @id @default(uuid())
  uploadSessionId String
  /// 0, 1, 2, ... (0 exactly when startOffset is 0, CHECK).
  chunkIndex      Int
  startOffset     BigInt
  /// 1..67,108,864 (CHECK).
  byteLength      Int
  /// The lease under which the chunk was committed (64 lowercase hex).
  leaseToken      String   @unique @db.Char(64)
  /// SHA-256 of the chunk (64 lowercase hex); NULL when not computed.
  sha256          String?  @db.Char(64)
  receivedAt      DateTime

  uploadSession RecordingUploadSession @relation(fields: [uploadSessionId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([uploadSessionId, chunkIndex])
  @@unique([uploadSessionId, startOffset])
}

// ---- Teacher storage accounting and quotas (Stage 3.1) ------------------------------------------
//
// Effective limit of a teacher: the individual override (TeacherStorageLimit)
// when a row exists, otherwise the current subscription plan's storageGB
// (decimal: 1 GB = 1,000,000,000 bytes), otherwise unlimited. Usage is
// computed from database rows that reference verified files in the unified
// storage (services/teacher-storage-usage-service.ts); it is never stored.
// Timestamps are written by the application with serverNow() (no database
// defaults). CHECK constraints are hand-written in migration
// 20261116120000_add_teacher_storage_accounting.

/// The administrator's individual storage limit for one teacher. A missing
/// row means "no override: use the subscription plan". 0 is a real limit
/// (nothing may be stored), never "unlimited". CHECK
/// TeacherStorageLimit_limitBytes_range: 0 .. 10^15 bytes (1 PB).
model TeacherStorageLimit {
  teacherId           String   @id
  limitBytes          BigInt
  updatedAt           DateTime
  /// The administrator responsible for the latest change (AdminSession).
  updatedByAdminId    String   @db.VarChar(191)
  updatedByAdminEmail String   @db.VarChar(320)

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade, onUpdate: Restrict)
}

/// Append-only audit of individual limit changes (never updated or deleted
/// by the application). previousLimitBytes / newLimitBytes are the individual
/// overrides before / after (NULL = no override); planLimitBytes is the plan
/// allocation at the time of the change (NULL = unlimited or no subscription).
/// CHECK TeacherStorageLimitChange_bytes_range on all three.
model TeacherStorageLimitChange {
  id                  String   @id @default(uuid())
  teacherId           String
  previousLimitBytes  BigInt?
  newLimitBytes       BigInt?
  planLimitBytes      BigInt?
  changedByAdminId    String   @db.VarChar(191)
  changedByAdminEmail String   @db.VarChar(320)
  changedAt           DateTime

  /// Restrict: the history outlives nothing it describes (teachers are never hard-deleted).
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([teacherId, changedAt])
}

enum StorageReservationCategory {
  NOTE
  SUBMISSION
  PROFILE_IMAGE
}

/// Capacity reserved for a Notes / assignment submission upload while its
/// file is being written (Recorded Lectures reserve through their ACTIVE /
/// COMPLETING RecordingUploadSession rows instead, never here). Expired rows
/// reserve nothing. CHECKs (migration 20261116120000_add_teacher_storage_accounting):
/// StorageReservation_bytes_range (1 .. 2,147,483,647, the Int range of
/// Note / AssignmentSubmission.sizeBytes), StorageReservation_expiry_after_creation,
/// StorageReservation_storageKey_format (the category's key layout) and
/// StorageReservation_storageKey_owner (the key is below Teachers/{teacherId}/).
model StorageReservation {
  id         String                     @id @default(uuid())
  teacherId  String
  category   StorageReservationCategory
  bytes      BigInt
  storageKey String                     @unique @db.VarChar(512)
  createdAt  DateTime
  expiresAt  DateTime

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([teacherId, expiresAt])
  @@index([expiresAt])
}

/// Kind of a tracked email (EmailDelivery). Extensible: add a value per new notification type.
enum EmailDeliveryType {
  /// The one welcome email of a new student (registration number + temporary password).
  STUDENT_WELCOME
  /// Teacher "Resend Login Details": a NEW temporary password, activated only after the email was accepted.
  STUDENT_CREDENTIAL_RESEND
}

/// PENDING: waiting for (another) attempt at nextRetryAt. PROCESSING: claimed by a worker
/// (lease until processingLeaseExpiresAt). SENT: ACCEPTED by the email provider (not proof of
/// inbox delivery). FAILED: no further automatic attempt (lastErrorCode says why).
enum EmailDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

/// Persistent email delivery tracking / outbox (services/student-email-delivery-service.ts,
/// worker: services/email-delivery-worker.ts). Rows are kept after sending (history).
///
/// Never stores a plaintext password or email body. encryptedPayload holds the temporary
/// password ONLY, AES-256-GCM encrypted with EMAIL_PAYLOAD_ENCRYPTION_KEY (kept outside the
/// database), bound to the row id; it is cleared once no longer needed (sent, superseded,
/// or payloadExpiresAt passed). Fingerprints are SHA-256 of bcrypt HASHES (never of passwords).
/// All timestamps are written by the application (real UTC instants).
model EmailDelivery {
  id             String              @id @default(uuid())
  emailType      EmailDeliveryType
  status         EmailDeliveryStatus @default(PENDING)
  studentId      String
  /// The student's teacher (ownership for the teacher-facing history / retry).
  teacherId      String
  /// PUBLIC_REGISTRATION | TEACHER_ADD | BULK_IMPORT | TEACHER_RESEND
  initiatedBy    String              @db.VarChar(32)
  /// Bulk import run that created the student (import summary); null otherwise.
  importBatchId  String?             @db.VarChar(64)
  /// Address used by the latest attempt (the student's current email at send time).
  recipientEmail String              @db.VarChar(320)
  /// One welcome per student ("student-welcome:<studentId>"); one per resend operation.
  idempotencyKey String              @unique @db.VarChar(200)

  attemptCount             Int       @default(0)
  maxAttempts              Int
  nextRetryAt              DateTime?
  lastAttemptAt            DateTime?
  processingStartedAt      DateTime?
  processingLeaseExpiresAt DateTime?
  /// Fencing token of the current claim (only its holder may finish the attempt).
  leaseToken               String?   @db.VarChar(64)
  /// Accepted by the provider (status SENT).
  sentAt                   DateTime?
  providerMessageId        String?   @db.VarChar(256)
  lastErrorCode            String?   @db.VarChar(64)
  /// Sanitized (no addresses, no credentials), at most 500 characters.
  lastErrorMessage         String?   @db.VarChar(500)
  /// The latest failure's outcome was unknown (timeout / connection lost): the email may have been sent.
  lastOutcomeAmbiguous     Boolean   @default(false)

  encryptedPayload      String?
  payloadExpiresAt      DateTime?
  /// SHA-256 of the bcrypt hash that the emailed password matches.
  credentialFingerprint String?   @db.Char(64)

  // STUDENT_CREDENTIAL_RESEND only: activation after the provider accepted the email.
  /// SHA-256 of the student's password hash when the resend was requested (unchanged = safe to activate).
  basePasswordFingerprint String?   @db.Char(64)
  baseSessionVersion      Int?
  /// bcrypt hash of the NEW temporary password, made the student's password only after acceptance.
  pendingPasswordHash     String?
  /// "resend:<studentId>" while the resend is unresolved: at most one per student (NULLs never clash).
  activeOperationKey      String?   @unique @db.VarChar(80)
  activatedAt             DateTime?
  /// Set when the new password could NOT be activated (e.g. ACCOUNT_CHANGED); the old one still works.
  activationErrorCode     String?   @db.VarChar(64)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([status, nextRetryAt])
  @@index([status, processingLeaseExpiresAt])
  @@index([teacherId, createdAt])
  @@index([studentId, createdAt])
  @@index([importBatchId])
}
